      "text": "%spark\nval win = Window.orderBy(\"id\")\n\nval recids = df\n  .withColumn(\"newrec\", ($\"record\" === \"RECORD\").cast(LongType))\n  .withColumn(\"recid\", sum($\"newrec\").over(win))\n  .select($\"recid\", $\"record\", $\"value\")\n\nrecids.show\n\n",
