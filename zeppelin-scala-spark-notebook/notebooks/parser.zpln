      "text": "%spark\nval spec=Window.orderBy(\"row_num\")\n\nval parsedFileWithGlobalIndex = parsedFile\n.withColumn(\"group_flag\", when(col(\"type_code\").startsWith(\"01\"),1).otherwise(0) )\n.withColumn(\"commulative_sum\", sum(\"group_flag\").over(spec))\n\n\nparsedFileWithGlobalIndex.show",
