    {
      "text": "%spark\n val l = List(1,2,3,4)\n\n  val partialFunction1: PartialFunction[Int, String] =\n    new PartialFunction[Int, String] {\n      override def apply(name: Int): String = if (name > 2) {\n        name.toString\n      } else\n        sys.error(\n          \"Operaiton Not supported:you should call isDefined at before calling apply\"\n        )\n\n      override def isDefinedAt(x: Int): Boolean = {\n        if (x > 2) true else false\n      }\n    }\n\n\n  val partialFunction2: PartialFunction[Int, Int] ={\n      case n if (n%2 == 0) => n\n      case _ => 0\n    }\n\n",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "53d277a303da4f1a82fcd"
    },
    {
      "text": "%spark\nimport org.apache.spark.sql.expressions.Window\nimport org.apache.spark.sql.functions._\nimport org.apache.spark.sql.types._\n\nval df = Seq(\n(\"RECORD\",\"record1identifier\"),\n(\"SUBRECORD\",\"value1\"),\n(\"SUBRECORD2\",\"value2\"),\n(\"RECORD\",\"record2identifier\"),\n(\"RECORD\",\"record3identifier\"),\n(\"SUBRECORD\",\"value3\"),\n(\"SUBRECORD\",\"value4\"),\n(\"SUBRECORD\",\"value5\")\n).toDS().rdd.zipWithIndex.map(r => (r._1._1, r._1._2, r._2)).toDF(\"record\", \"value\", \"id\")\n\n",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "e1dd24be119e416e976d2"
    },
    {
      "text": "%spark\n// Step 1: Read and parse the text file\n  val parsedFile =rdd\n  .filter(_.trim.nonEmpty)\n  .map { line =>\n    val parts = line.trim.split(\"\\\\s+\")\n    (parts(0), parts(1), parts(2))\n  }.toDF(\"id\", \"type_code\", \"location\")\n  .withColumn(\"row_num\", monotonically_increasing_id())\n\n  parsedFile.show",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
