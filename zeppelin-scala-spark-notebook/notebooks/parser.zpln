    {
      "text": "%spark\nval recs = recids.where($\"record\"===\"RECORD\").select($\"recid\", $\"value\".as(\"recname\"))\nval subrecs = recids.where($\"record\" =!= \"RECORD\").select($\"recid\", $\"value\".as(\"attr\"))\n\nrecs.join(subrecs, Seq(\"recid\"), \"left\").groupBy(\"recname\").agg(collect_list(\"attr\").as(\"attrs\")).show()",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
