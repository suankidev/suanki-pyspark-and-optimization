      "id": "7bfdde52653b4b5987387"
    },
    {
      "text": "%spark\nimport org.apache.spark.sql.functions._\n\nds.select(col(\"dest\"),col(\"count\").as[Double]  ).take(4)",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
