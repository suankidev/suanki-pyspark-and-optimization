      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "049d0a0ddc1f4616960f3"
    },
    {
      "text": "%spark\nval rdd1 = sc.makeRDD(Array((\"A\",\"1\"),(\"B\",\"2\"),(\"C\",\"3\")),2)\nval rdd2 = sc.makeRDD(Array((\"A\",\"a\"),(\"C\",\"c\"),(\"D\",\"d\")),2)\nval joinRdd = rdd1.join(rdd2)\n\njoinRdd.collect\n",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
