      "text": "%spark\ndf.withColumn(\"whenThen\", when(df(\"count\") === 264, \"two sixty four\")\n.when(df(\"count\") === 1, \"one\")\n.when(df(\"count\") === 24, \"twenty frour\")\n.otherwise(\"no match\")\n).show",
      "config": {
