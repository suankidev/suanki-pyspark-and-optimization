          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "ff00afc183a74cd5b8ebb"
    },
    {
      "text": "%spark\ndf.filter(df(\"name\") === \"Skuma\").show()",
      "config": {
