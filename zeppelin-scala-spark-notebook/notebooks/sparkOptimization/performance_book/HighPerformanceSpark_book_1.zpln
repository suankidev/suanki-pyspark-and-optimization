    {
      "text": "%spark\ndef withStopWordsFiltered(rdd : RDD[String], illegalTokens : Array[Char],\n      stopWords : Set[String]): RDD[(String, Int)] = {\n      val separators = illegalTokens ++ Array[Char](' ')\n      val tokens: RDD[String] = rdd.flatMap(_.split(separators).\n      map(_.trim.toLowerCase))\n      val words = tokens.filter(token =>\n      !stopWords.contains(token) && (token.length > 0) )\n      val wordPairs = words.map((_, 1))\n      val wordCounts = wordPairs.reduceByKey(_ + _)\n      wordCounts\n}",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "1efbb0e3564a48b48e1be"
    },
    {
      "text": "%spark\n\nimport org.apache.spark.rdd.RDD\n\ndef wordCount(rowRdd:RDD[String]):RDD[(String, Int)]={\n\n retailRdd.flatMap(row => row.split(\",\"))\n .map(row => (row, 1)).reduceByKey((x,y) => (x+y))\n\n}",
