{
  "id": "1TQ6YA6JI",
  "name": "4.Join_Sql_Core",
  "paragraphs": [
    {
      "text": "\n###Spark sql join",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/markdown",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "markdown",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "aeb9b7f7dab946a893730"
    },
    {
      "text": "%spark\nval scoreData = Seq( (1, 1001), (2, 1002), (3,1003), (4, 10004),(4, 100089))\nval pandaAddress = Seq((1, \"A\"),\n(2, \"B\"),\n(3, \"C\"),\n(4, \"D\"),\n(5, \"E\")\n)\n\n\nval scoreRdd = sc.parallelize(scoreData,2)\nval pandaAddressRdd = sc.parallelize(pandaAddress,2)\n",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "4f1de0e11aed4f1297ed1"
    },
    {
      "text": "%spark\n\nrslt.reduceByKey((x,y) => if(x._1 > y._1) x else y)\n.collect",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "34060814a2c04a64b51c5"
    },
    {
      "text": "%spark\n\ndef joinScoredsWithAddress1(scoreRdd:RDD[(Int,Int)]):RDD[(Int, (Int, String) )]={\n\n  val joinedRdd = scoreRdd.join(pandaAddressRdd)\n  joinedRdd\n  \n}\n\n\ndef joinScoredsWithAddress2(scoreRdd:RDD[(Int,Int)]):RDD[(Int, (Int, String) )]={\n//removing lower score for the panda\n  val joinedRdd = scoreRdd.reduceByKey((x,y) => if(x > y) x else y).join(pandaAddressRdd)\n  joinedRdd\n  \n}\n\n\n\nval rslt = joinScoredsWithAddress1(scoreRdd)\nval rslt1 = joinScoredsWithAddress2(scoreRdd)\n\nrslt1.collect\n",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "c49ebee99044444c94f3a"
    },
    {
      "text": "%spark\nscoreRdd.reduceByKey(addressDataPartitioner, (x,y) => if(x>y) x else y)\n.join(pandaAddressRdd)\n.partitions",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "8e4df9d009fd43a1814c5"
    },
    {
      "text": "%spark\n",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "7ecbfb55b1c84753bd5b9"
    },
    {
      "text": "%spark\nspark.conf.set(\"spark.sql.autoBroadcastJoinThreshold\",\"10m\")\nspark.conf.set(\"spark.sql.broadcastTimeout\",\"600s\")",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "beb5977d057243ada68ff"
    },
    {
      "text": "%spark\nscoreRdd.reduceByKey((x,y) => if(x>y) x else y).collect",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "6574cbdf62e445b0aa9bb"
    },
    {
      "text": "%spark\nsizesdf.join(zipCode, sizesdf(\"name\") === zipCode(\"name\"),\"left_semi\").show  //only matching record from left table without duplicates",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
