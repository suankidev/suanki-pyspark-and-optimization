      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "c46a7791cd174f399e3ec"
    },
    {
      "text": "%spark\nimport org.apache.spark.broadcast.Broadcast\n\nval s = sizesdf.join(sc.broadcast(zipCode),sizesdf(\"name\") === zipCode(\"name\"),\"left_anti\")",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
