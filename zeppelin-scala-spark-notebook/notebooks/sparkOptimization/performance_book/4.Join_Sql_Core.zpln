      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "4fbc44fca98b434f89bd9"
    },
    {
      "text": "https://stackoverflow.com/questions/31424396/how-does-hashpartitioner-work",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/markdown",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "markdown",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "faf5e6590d7d4d43ad697"
    },
    {
      "text": "%spark\nimport org.apache.spark.HashPartitioner\n\nval addressDataPartitioner = pandaAddressRdd.partitioner match{\n  case (Some(p)) => p\n  case (None) => new HashPartitioner(pandaAddressRdd.partitions.length)\n  // case (None) => new HashPartitioner(5)\n}",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "b77acdf8107243bb8dc0d"
    },
    {
      "text": "%spark\nval  sizesdf = Seq(\n  (\"Happy\",1.0),\n  (\"Sad\",0.9),\n  (\"Happy\",1.5),\n  (\"Coffee\",3.0)).toDF(\"name\",\"size\")\n\nval zipCode = Seq(\n  (\"Happy\",94110),\n  (\"Happy\",94103),\n  (\"Coffee\",10504),\n  (\"Tea\",7012)\n).toDF(\"name\",\"zip\")",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "22e1482269fe4b8c8b485"
    },
    {
      "text": "%spark\nsizesdf.join(zipCode, sizesdf(\"name\") === zipCode(\"name\"),\"left\").show",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "4bdb2abef83f4c3698108"
    },
    {
      "text": "%spark\nscoreRdd.leftOuterJoin(pandaAddressRdd).collect",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
