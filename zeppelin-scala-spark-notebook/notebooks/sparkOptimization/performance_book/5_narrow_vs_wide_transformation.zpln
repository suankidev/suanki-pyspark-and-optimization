      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "e4dc15d4179f4b50b5b56"
    },
    {
      "text": "%spark\nval df = spark.read.parquet(\"/FileStore/tables/suankiData/raw/transaction\")\ndf.rdd.getNumPartitions",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
