    {
      "text": "%spark\nimport org.apache.spark.sql.functions._\n\nval tranRdd = df.limit(10)\n.orderBy(col(\"date\"))\n.drop(\"end\", \"txnId\", \"start_date\",\"end_date\",\"txn_id\",\"year\", \"month\", \"day\", \"expense_type\", \"amt\")\n\n// tranRdd.show(2,false)\ncase class Transaction(id:String, date:String,  city:String) extends Serializable \n\ntranRdd.map(x => x.getString(0))\n\n//dataset of Transaction\nval tran = tranRdd.map(x => \nTransaction(x.getString(0), x.getString(1),x.getString(2))\n)",
