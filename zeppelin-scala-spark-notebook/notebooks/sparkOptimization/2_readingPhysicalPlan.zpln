    {
      "text": "%spark\nval df_narrow_transformation = customerDF\n.filter(col(\"city\") === \"boston\")\n.withColumn(\"first_name\", split(col(\"name\"),\" \")(0))\n.withColumn(\"last_name\", split(col(\"name\"),\" \")(1))\n.withColumn(\"age\", col(\"age\") + lit(5))\n.selectExpr(\n  \"cust_id\",\n  \"first_name\",\n  \"last_name\",\n  \"age\",\n  \"gender\",\n  \"birthday\"\n)\n",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
