    {
      "text": "%spark\nimport org.apache.spark.sql.functions._\n\nval custDF=spark.read.parquet(\"/FileStore/tables/suankiData/raw/customer\")\n\nval finalDf=custDF.filter(col(\"city\") === \"boston\")\n.withColumn(\"first_name\", split(col(\"name\"),\" \")(0))\n.withColumn(\"last_name\", split(col(\"name\"),\" \")(1))\n.withColumn(\"age\", col(\"age\") + lit(5))\n.selectExpr(\n  \"cust_id\",\n  \"first_name\",\n  \"last_name\",\n  \"age\",\n  \"gender\",\n  \"birthday\"\n)\n\nfinalDf.write.format(\"noop\")\n.mode(\"overwrite\")\n.save(\"/FileStore/tables/suankiData/processed/customer\")\n\n//will trigger only two jobs, since this has only two action\n//job-1  reading the data\n//job-2 writing the data ..since there is no exchange only one stage would be created\n\n// overall 2 jobs and 2 stage\n",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "e0850132d1364a2db1b84"
    },
    {
      "text": "%spark\ntransactionDF\n.groupBy(\"cust_id\")\n.agg(countDistinct(\"city\").alias(\"customer_distinct_purchase_city\"))\n.explain",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
