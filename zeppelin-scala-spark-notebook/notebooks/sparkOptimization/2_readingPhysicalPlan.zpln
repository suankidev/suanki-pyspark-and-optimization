      },
      "id": "cbe16aa3437a45ddb2bd3"
    },
    {
      "text": "%spark\nval joinDF = transactionDF.join(\n  f.broadcast(customerDF),\n  transactionDF.col(\"cust_id\") === customerDF.col(\"cust_id\"),\n  \"inner\"\n)",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
