    },
    {
      "text": "####Maps\nMaps are created by using the map function and key-value pairs of columns. You then can select\nthem just like you might select from an array:\n\n>//You can also explode map types, which will turn key and value  into seprate column columns",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/markdown",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "markdown",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "a358f2ec542d4280a84c3"
    },
    {
      "text": "%spark\ncomplexDF.select(f.explode(f.col(\"complex_map\"))).show(5,false)",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "a972e583d5504bb1b06e9"
    },
    {
      "text": "%spark\n/*\nSELECT\nifnull(null, 'return_value'),\nnullif('value', 'value'),\nnvl(null, 'return_value'),\nnvl2('not_null', 'return_value', \"else_value\")\nFROM dfTable LIMIT 1\n*/\n\nimport org.apache.spark.sql.{functions => f}\nval data=Seq(\n(\"101\",   \"sujeet\",  null),\n(\"102\",   null,     \"23\"),\n(\"103\",   null,     null),\n(\"104\",   \"Rajoo\",  null)\n)\n\nval df = data.toDF(\"id\",\"name\",\"age\")\n\ndf.\nselect(\n   f.col(\"id\"), f.col(\"name\"),f.col(\"age\"),\n   f.coalesce(f.col(\"name\"), f.col(\"age\")),\n   f.expr(\"ifnull(name,age)\").as(\"ifnull\"),\n   f.expr(\"nullif(name,age)\").as(\"nullif\"),\n   f.expr(\"nvl(name,age)\").as(\"nvl\"),\n   f.expr(\"nvl2(name,age,'else_val')\").as(\"nvl2\")\n)\n.show(5, false)",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "b1b583573fdc4c2f8e874"
    },
    {
      "text": "####explode and explode_outer\nThe explode function takes a column that consists of arrays and creates one row (with the rest of\nthe values duplicated) per value in the array\n\n  - **explode_outer**: duplicate row for null value in array",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/markdown",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "markdown",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "e4e1bccdf46142c2b8e87"
    },
    {
      "text": "%spark\nexplodedDF.groupBy(splittedInArray,f.col(\"country\")).agg(f.collect_set(f.col(\"exploded\"))).show(5,false) //revert exploded value",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "1c07d711e9a44d508f996"
    },
    {
      "text": "%spark\nval timeData = Seq(\n            (\"2019-07-01 12:01:19\",\n            \"07-01-2019 12:01:19\", \n            \"07-01-2019\")\n            )\n\nval timeDf = timeData.toDF(\"dateOne\",\"dateTwo\",\"dateThree\")\n\ntimeDf.show()",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "d22bcd5f889c41cd8258c"
    },
    {
      "text": "%spark\nval ListOfCol = List(\"a\",\"b\",\"c\",\"d\")\nval selectedCols = for(c <- ListOfCol) yield f.lit(\"null\").alias(c)\nval finalSelectCols = f.col(\"*\") +: selectedCols\ndf.select( finalSelectCols:_*).show\n",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "ce92afa9bcc94d1398ee7"
    },
    {
      "text": "%spark\nretailDF\n.select(f.split(f.col(\"Description\"),\" \"), f.col(\"Description\")).printSchema",
      "config": {
        "colWidth": 12,
