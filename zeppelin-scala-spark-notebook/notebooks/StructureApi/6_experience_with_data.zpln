    {
      "text": "%spark\nimport org.apache.spark.sql.functions.{regexp_replace,col}\nimport org.apache.spark.sql.types.{DecimalType}\n\ndataDf\n.withColumn(\"smoothingFactor\", regexp_replace(col(\"smoothingFactor\"), \"\\\\,\", \".\"))\n.withColumn(\"smoothingFactor\", col(\"smoothingFactor\").cast(DecimalType(10,2)))\n.withColumn(\"meanDemandValue\", regexp_replace(col(\"smoothingFactor\"), \"\\\\,\", \".\"))\n.show",
      "config": {
