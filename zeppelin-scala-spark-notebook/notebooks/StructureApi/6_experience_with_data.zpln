    {
      "text": "%spark\n\n//https://sparktpoint.com/spark-regexp_replace-string/\n\n//how to convert EU standard string to deciaml value\n\n\nval dataDf = Seq(\n  (\"+0,00\", \"+000000000,000000\"),\n  (\"-0,60\", \"+000321805,000000\"),\n  (\"+0,41\", \"-000077955,000000\")\n).toDF(\"smoothingFactor\",\"meanDemandValue\")\n\n\ndataDf.show\n\n\ncase class dataDS(smoothingFactor:Double, meanDemandValue:Double)",
