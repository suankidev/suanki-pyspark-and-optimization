    {
      "text": "%spark\n//Permissive\n//have to write code explicitly to handle the corrupted record.\n\nimport org.apache.spark.sql.types.{StructType,StructField,StringType,IntegerType}\n\nval schema = StructType(\n    Seq(\n    StructField(\"DEST_COUNTRY_NAME\", StringType, true),\n    StructField(\"ORIGIN_COUNTRY_NAME\",StringType, true),\n    StructField(\"NO_OF_FlIGHTS\", IntegerType, true),\n    StructField(\"_corrupt_record\", StringType, true)\n)\n)\n\nval df = spark\n.read\n.format(\"csv\")\n.option(\"mode\",\"permissive\")\n.option(\"header\",true)\n.option(\"columnNameOfCorruptRecord\", \"_corrupt_record\")\n.schema(schema)\n.load(\"dbfs:/FileStore/tables/suankiData/raw/flightData/2015_summary.csv\")",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "2fc5c377e21342d4b6b3d"
    },
