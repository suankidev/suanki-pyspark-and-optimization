    },
    {
      "text": "%spark\ntransactionDF.sortWithinPartitions(\"city\").explain",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
