      "text": "%spark\ntry{\n  jsonflightDf2015\n  .write\n  .format(\"csv\")\n.mode(\"errorIfExists\")\n.save(\"dbfs:/FileStore/tables/suankiData/processed/flightData\")\n}\ncatch {\n  case e:Exception => println(\"Exeception occured\")\n}",
