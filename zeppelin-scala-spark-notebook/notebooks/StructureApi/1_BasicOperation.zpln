    {
      "text": "%spark\ntransactionDF1.rdd.getNumPartitions  //action will trigger and will cause shuffle of memory partition data",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
