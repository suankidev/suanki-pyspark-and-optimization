    {
      "text": "%spark\n\ndef getConf(value:String):String = spark.conf.get(value)\n\nprintln(\n  s\"\"\"|getNumPartitions: ${transactionDF.rdd.getNumPartitions}\n      |defaultParallelism: ${spark.sparkContext.defaultParallelism}\n      |spark.sql.adaptive.enabled: ${getConf(\"spark.sql.adaptive.enabled\")}\n      |spark.sql.files.maxPartitionBytes: ${getConf(\"spark.sql.files.maxPartitionBytes\")} ==>  128mb\n      |spark.sql.inMemoryColumnarStorage: ${getConf(\"spark.sql.inMemoryColumnarStorage.compressed\")}\n      |spark.sql.inMemoryColumnarStorage: ${getConf(\"spark.sql.inMemoryColumnarStorage.batchSize\")}\n      |spark.sql.shuffle.partitoins: ${getConf(\"spark.sql.shuffle.partitions\")}\n      |spark.sql.autoBroadcastJoinThreshold: ${getConf(\"spark.sql.autoBroadcastJoinThreshold\")}  ==> 10mb\n\"\"\".stripMargin('|')\n)",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
