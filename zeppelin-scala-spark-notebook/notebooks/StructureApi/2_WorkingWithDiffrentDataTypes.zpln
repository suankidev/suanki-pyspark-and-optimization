      "id": "3ac571f7718a4274b7a73"
    },
    {
      "text": "%spark\nval initCap = f.initcap(f.col(\"description\"))  //capatilize\nval lowe = f.lower(f.col(\"description\"))  //lower\nval uppe = f.upper(f.col(\"description\"))  //upper\nval tr = f.trim(f.lit(\" Hello \"))  //trim spaces from left and right\nval ltri = f.ltrim(f.lit(\" Hello   \"))  //trim spaces from left\nval lpad = f.lpad(f.lit(\"Hello\"), 3, \"-\")  //from left onl three char\nval lpad1 = f.lpad(f.lit(\"He\"), 3, \"-\")  //if there are less than three, will filled by '-' from left \n\n\nretailDF.select(\n  initCap,\n  lowe,\n  uppe,\n  tr,\n  ltri,\n  lpad,\n  lpad1\n).show(5, false)\n\n\n\n",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "33cea3839ba3446293af0"
    },
    {
      "text": "%spark\n//imagin the true quantity = (quantity * unitproce)^2 + 5\n\nval fabricatedQuantity = f.pow(f.col(\"quantity\") * f.col(\"unitprice\"), 2) + 5\n\nretailDF\n  .select(f.col(\"quantity\"), fabricatedQuantity.alias(\"realQuantity\"))\n  .withColumn(\"round\", f.round(f.col(\"realQuantity\"),2))\n  .show(2,false)",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "f0875049098248a58bfcd"
    },
    {
      "text": "%spark\n//This is trivial with just two values, but it becomes more complicated when there are values\nval containsBlack = f.col(\"Description\").contains(\"BLACK\")\nval containsWhite = f.col(\"DESCRIPTION\").contains(\"WHITE\")\n\nretailDF.withColumn(\"hasSimplecolor\", containsBlack || containsWhite )\n.filter(f.col(\"hasSimplecolor\"))\n.show(5, false)",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
