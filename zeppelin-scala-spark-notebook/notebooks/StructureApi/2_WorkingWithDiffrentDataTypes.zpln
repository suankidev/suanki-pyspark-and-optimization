      "id": "b719c4c41d044c78ab1a4"
    },
    {
      "text": "%spark\n",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
