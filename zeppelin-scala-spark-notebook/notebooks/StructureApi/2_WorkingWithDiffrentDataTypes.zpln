    {
      "text": "%spark\nretailDF.withColumn(\"increasingId\", f.monotonically_increasing_id()).show(5,false)  \n//The assumption is that the data frame has less than 1 billion partitions, and each partition has less than 8 billion records.",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
