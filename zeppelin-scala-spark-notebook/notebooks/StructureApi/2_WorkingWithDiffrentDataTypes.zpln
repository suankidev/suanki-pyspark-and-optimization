      "id": "7dc0bf4661d54aed89c6a"
    },
    {
      "text": "%spark\n",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
