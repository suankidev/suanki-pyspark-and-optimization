      "id": "da24d7b27c084c898f164"
    },
    {
      "text": "%spark\nval priceFilter = f.col(\"UnitPrice\") > 600\nval descripFilter = f.col(\"Description\").contains(\"POSTAGE\")\n\nretailDF.where(f.col(\"stockcode\").isin(\"DOT\")).where(priceFilter || descripFilter).show(5,false)",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "a0bd69f2382a4363b5719"
    },
    {
      "text": "%spark\n//above transformation can be written as below in using expression\n//https://spark.apache.org/docs/latest/api/scala/org/apache/spark/sql/Column.html#isInCollection(values:Iterable[_]):org.apache.spark.sql.Column\nretailDF\n.withColumn(\"isExpensive\", !( f.col(\"UnitPrice\") <= 250))\n.filter(\"isExpensive\")\n.select(\"description\",\"unitprice\")\n.show(5,false)",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
