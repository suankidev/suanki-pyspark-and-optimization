    {
      "text": "%spark\n// spark.sql(\"SET TIME ZONE 'IST'\")  //changing to IST\nspark.conf.get(\"spark.sql.session.timeZone\",\"IST\")\nspark.conf.get(\"spark.sql.session.timeZone\")\nval dateDF = spark\n.range(5)\n.withColumn(\"today\", f.current_date())\n.withColumn(\"now\", f.current_timestamp())\ndateDF.printSchema\n\ndateDF.show()",
      "config": {
