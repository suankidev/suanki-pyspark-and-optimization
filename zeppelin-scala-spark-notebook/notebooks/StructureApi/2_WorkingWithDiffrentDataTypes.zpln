    {
      "text": "%spark\nval unixTime = f.unix_timestamp(f.col(\"dateTwo\"), \"MM-dd-yyyy HH:mm:ss\")\n\ntimeDf.select(\n  f.unix_timestamp(f.col(\"dateOne\")).alias(\"epochTime\"),\n  f.unix_timestamp(f.col(\"dateTwo\"), \"MM-dd-yyyy HH:mm:ss\").alias(\"epochByformate\"),\n  f.unix_timestamp(f.col(\"dateThree\"), \"MM-dd-yyyy\"),\n  f.from_unixtime(unixTime).as(\"fromEpoch\"),\n  f.from_unixtime(unixTime,\"yyyy-dd-MM\").as(\"fromEpochWithFormat\")\n)\n.show()",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
