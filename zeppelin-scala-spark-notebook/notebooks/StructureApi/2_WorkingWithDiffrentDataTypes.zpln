    {
      "text": "%spark\ncleanedDF\n.withColumn(\"totimestamp\", f.to_timestamp(f.col(\"today\")))\n.withColumn(\"totimestampWithDateFormate\", f.to_timestamp(f.col(\"today\"), \"yyyy-MM-dd\"))  //in case date are in some specific format\n.withColumn(\"todateOnNow\", f.to_date(f.col(\"now\")))\n.show(false)",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
