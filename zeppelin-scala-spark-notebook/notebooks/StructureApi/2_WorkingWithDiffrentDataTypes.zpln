    {
      "text": "%spark\nval timeData = Seq(\n            (\"2019-07-01 12:01:19\",\n            \"07-01-2019 12:01:19\", \n            \"07-01-2019\"))\n\nval timeDf = timeData.toDF(\"dateOne\",\"dateTwo\",\"dateThree\")\n\ntimeDf.show()",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
