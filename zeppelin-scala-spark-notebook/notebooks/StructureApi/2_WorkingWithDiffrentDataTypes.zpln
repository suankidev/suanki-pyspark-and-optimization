    },
    {
      "text": "####lit\n\nThe lit functions. This functions converts a type in another language to its corresponding Spark representation\n",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/markdown",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "markdown",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "a38096746890436f87430"
    },
    {
      "text": "%spark\nval dateDF = spark\n.range(5)\n.withColumn(\"today\", f.current_date())\n.withColumn(\"now\", f.current_timestamp())\ndateDF.printSchema\ndateDF.show()",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "5556dd692d994bcd829f1"
    },
    {
      "text": "%spark\n/**\nImplicit type casting is an easy way to shoot yourself in the foot, especially when dealing with null\nvalues or dates in different timezones or formats. We recommend that you parse them explicitly\ninstead of relying on implicit conversions.\n\n**/",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "46659dfc4bfa4125930cc"
    },
