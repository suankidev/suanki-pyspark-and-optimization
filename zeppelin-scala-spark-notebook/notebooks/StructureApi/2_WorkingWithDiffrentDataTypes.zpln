    },
    {
      "text": "%spark\n//Notice how we did not need to specify our filter as an expression and how we could use a column name without any extra work\nval dotCodFilter = f.col(\"stockCode\") === \"DOT\"\n\nretailDF.withColumn(\"isExpensive\", dotCodFilter.and(priceFilter.or(descripFilter))).show(5, false)",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
