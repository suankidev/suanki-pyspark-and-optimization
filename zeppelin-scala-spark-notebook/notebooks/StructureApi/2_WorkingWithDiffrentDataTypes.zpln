        "params": {},
        "forms": {}
      },
      "id": "aca5c31a4ae343ecb6277"
    },
    {
      "text": "%spark\nretailDF\n  .withColumn(\"nullSafeCustomerID\",f.col(\"customerId\").eqNullSafe(\"15987.0\"))\n  .where(f.col(\"nullSafeCustomerID\"))  //select value which is null , working in java style, but same can be handel by using isnull, isnotnull\n  .show()",
      "config": {
