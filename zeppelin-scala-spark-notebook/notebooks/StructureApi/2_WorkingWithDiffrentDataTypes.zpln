    {
      "text": "%spark\nval simpleColors = Seq(\"black\", \"white\", \"red\", \"green\", \"blue\")\nval regexString = simpleColors.map(_.toString.toUpperCase).mkString(\"|\")\nval regexExtractString = simpleColors.map(_.toUpperCase).mkString(\"(\",\"|\",\")\")\nprintln(regexString)",
