    {
      "text": "%spark\ndateDF.select(f.to_date(f.lit(\"2016-20-12\")),f.to_date(f.lit(\"2017-12-11\"))).show(1)  //yyyy-mm-dd ",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
