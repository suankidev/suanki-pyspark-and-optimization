    {
      "text": "%spark\n/*\nIf there is a null in your data, you’ll need to treat things a bit differently. Here’s how you can ensure\nthat you perform a null-safe equivalence test:\ndf.where(col(\"Description\").eqNullSafe(\"hello\")).show()\n*/",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
