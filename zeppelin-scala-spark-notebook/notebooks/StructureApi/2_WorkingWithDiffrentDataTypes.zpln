      "id": "7b1e7ca36eb842e1ad3ba"
    },
    {
      "text": "%spark\nretailDF\n.withColumn(\"isExpensive\", f.not( f.col(\"UnitPrice\").leq(250)))\n.filter(\"isExpensive\")\n.select(\"description\",\"unitprice\")\n.show(5,false)",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "a362a1f774814f63b62a4"
    },
    {
      "text": "%spark\n/**\nLet’s fix this pipeline, step by step, and come up with a robust way to avoid these issues entirely.\nThe first step is to remember that we need to specify our date format according to the Java\nSimpleDateFormat standard.\nWe will use two functions to fix this: to_date and to_timestamp. The former optionally\nexpects a format\n**/",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "ae59cb500fa14c1b92235"
    },
    {
      "text": "%spark\n/**\nSpark’s TimestampType class supports only second-level precision, which means that if\nyou’re going to be working with milliseconds or microseconds, you’ll need to work around this\nproblem by potentially operating on them as longs\n**/",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "57acc9b2356b46e691e9c"
    },
    {
      "text": "%spark\nval cleanedDF = dateDF.select(\n f.col(\"*\"),\n f.to_date(startDate,dateFormatOne).alias(\"todate\")\n)\ncleanedDF.show(false)",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
