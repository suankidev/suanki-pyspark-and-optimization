    {
      "text": "%spark\nspark.conf.get(\"spark.sql.session.timeZone\")  //default TZ of the system\nspark.sql(\"SET TIME ZONE 'America/Los_Angeles'\")\nspark.conf.get(\"spark.sql.session.timeZone\")",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
