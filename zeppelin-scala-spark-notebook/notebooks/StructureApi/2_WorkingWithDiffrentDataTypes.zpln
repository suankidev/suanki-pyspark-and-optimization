      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "ed5430ef281e4b08b34b9"
    },
    {
      "text": "%spark\nspark\n.range(5)\n.toDF(\"num\")\n.select(f.round(f.lit(2.5) , 0) ,  f.bround(f.lit(2.5), 0))\n.show()",
      "config": {
