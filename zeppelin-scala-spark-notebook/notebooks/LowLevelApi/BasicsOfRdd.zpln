    {
      "text": "###checkpoint\n*Checkpointing\nis the act of saving an RDD to disk so that future references to this RDD point to those\nintermediate partitions on disk rather than recomputing the RDD from its original source. This is\nsimilar to caching except that it’s not stored in memory, only disk.\n*",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/markdown",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "markdown",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "1df0c87192ba460885a19"
    },
