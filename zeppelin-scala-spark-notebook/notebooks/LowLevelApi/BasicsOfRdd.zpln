      "id": "11916cbbf3ea4e45b56bd"
    },
    {
      "text": "%spark\n\n\nval recordbylength = grouping\n.map(row => \n(row._1,row._2.groupBy(_.length ))\n)\n\n\nrecordbylength.collect",
      "config": {
