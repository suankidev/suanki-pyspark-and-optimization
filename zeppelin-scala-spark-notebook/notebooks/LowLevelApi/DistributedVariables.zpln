    {
      "text": "%spark\nval myMappedValue = Map(\"United States\" -> \"Business Class\", \"China\" -> \"Economic class\", \"other\" -> \"Lower Class\")\n\nval myMappedValueBr = spark.sparkContext.broadcast(myMappedValue)\n\nfinalflightRdd.map(row => (row(0), row(1), row(2), myMappedValueBr.value.getOrElse(row(0), \"Lower class\"))).take(5)\n\n",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
