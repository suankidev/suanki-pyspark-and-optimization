      "id": "d7d774de255349918dd1b"
    },
    {
      "text": "%spark\n/**\nbroadcast variables:\n**/\n\nval myCollection = \"Spark The Definitive Guide : Big Data Processing Made Simple\"\n.split(\" \")\n\n//if you will not give parallelization 2 then spark.sparkContext.defaultParallelism will be  used\nval words = spark.sparkContext.parallelize(myCollection, 2)   //Array(Spark, The, Definitive, Guide, :, Big, Data, Processing, Made, Simple)\n\n//broadcasting variables for lookup\nval supplementalData = Map(\"Spark\" -> 1000, \"Definitive\" -> 200,\"Big\" -> -300, \"Simple\" -> 100)\nval suppBroadcast = spark.sparkContext.broadcast(supplementalData)\n\n",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "01c5ddce4ae24fcb9a4e6"
    },
    {
      "text": "#Exercise to test knowledge",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/markdown",
