        "forms": {}
      },
      "id": "e5d8a3ca44544cc8a4001"
    },
    {
      "text": "###broadcast",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/markdown",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "markdown",
          "editOnDblClick": false,
