      "text": "%spark\n\nval usCount = spark.sparkContext.longAccumulator(\"Test\")\nusCount.value           \n\n\nfinalflightRdd\n.foreach(row => {\nusCount.add(row(2).toLong)\n})\n\n usCount.value\n\n",
