      },
      "id": "1f46df016d2d44379e79e"
    },
    {
      "text": "%spark\n    val headerCount: Int = 0\n\n    val footerCount: Int = 0\n    val finalHeaderCount: Int = headerCount\n\n    val finalFooterCount: Long = if (footerCount == 0) fileRdd.count() else fileRdd.count() - (headerCount + footerCount)\n    val fileRddWithIndex = fileRdd.zipWithIndex().filter(x => x._2 >= finalHeaderCount && x._2 <= finalFooterCount )\n\n",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
