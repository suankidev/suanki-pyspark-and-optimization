    {
      "text": "%spark\n//how cogroup works, rquire pair rdd\n\nval rdd2 = spark.sparkContext.parallelize(1 to 10, 2).map(row => (row, row*2))\nval rdd3 = spark.sparkContext.parallelize(10 to 20, 2).map(row => (row, row*3))\nval rdd4 = spark.sparkContext.parallelize(20 to 30, 2).map(row => (row, row*4))\n\nrdd2.cogroup(rdd3, rdd4).collect",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "5d1ac5c4710440ed879a3"
    },
    {
      "text": "%spark\n\n    val fileRddSplitted = fileRddWithIndex.map(row => row._1).map(_.split(\",\"))\n    \n    fileRddSplitted.collect\n",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
