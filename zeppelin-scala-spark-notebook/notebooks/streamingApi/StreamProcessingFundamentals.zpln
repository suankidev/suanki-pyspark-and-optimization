      "text": "%spark\nstreaming.withColumn(\"stairs\", expr(\"gt like '%stairs%'\"))\n.where(\"stairs\")\n.where(\"gt is not null\")\n.select(\"gt\", \"model\", \"arrival_time\", \"creation_time\")\n.writeStream\n.queryName(\"simple_transform\")\n.format(\"memory\")\n.outputMode(\"append\")\n.start()",
