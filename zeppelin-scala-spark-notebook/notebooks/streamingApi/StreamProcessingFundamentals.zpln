      "text": "%spark\nval deviceModelStats = streaming.cube(\"gt\", \"model\").avg()\n.drop(\"avg(Arrival_time)\")\n.drop(\"avg(Creation_Time)\")\n.drop(\"avg(Index)\")\n.writeStream.queryName(\"device_counts\").format(\"memory\").outputMode(\"complete\")\n.start()",
