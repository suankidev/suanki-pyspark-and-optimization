    {
      "text": "%spark\ndef prepareJson(version:Version) =new GsonBuilder()\n      .setDateFormat(\"yyyy-MM-dd\")\n      .disableHtmlEscaping()\n      .create()\n      .toJson(\n        version\n      )\n",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
