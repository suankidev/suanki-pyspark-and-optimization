      "id": "fb2613442f634477b76f3"
    },
    {
      "text": "%spark\nimport com.google.gson.GsonBuilder\n\ncase class Param(runDate:String, version:String, versionName:String,bucket:String, prefix:String, versionType:String)\n\nval config:Param  = \nParam(\"2024-03-24\", \"273927\", \"2024-03-24_273927\", \"s3://test/parsed\",\"parsed\",\"MAJOR\")\n\ncase class Version(\n                      runDate: String,\n                      version: String,\n                      versionName: String,\n                      bucket: String,\n                      prefix: String)\n\ncase class DpvVersion(\n                    `type`:String,\n                    version:Version\n                    )\n\nobject DpvVersion {\n\n  def fromConfig(cfg: Param) = {\n    val versions: List[String] = List(\"major\", \"bom\", \"minor\")\n  \n  versions.map(version => prepareSsm(_, cfg)\n    )\n\n  \n  }\n\n\n  def prepareSsm(value: String, cfg: Param) = {\n\n    val someVersion = Version(\n      runDate = cfg.runDate,\n      version = cfg.version,\n      versionName = s\"${cfg.runDate}_${cfg.version}\",\n      bucket = cfg.bucket,\n      prefix = cfg.prefix)\n\n   scala.collection.immutable.Map(value -> someVersion)\n  }\n\n\n}\n",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "52cf98b1b7e24d8cbbb74"
    },
    {
      "text": "%spark\nval t=new GsonBuilder()\n      .setDateFormat(\"yyyy-MM-dd\")\n      .disableHtmlEscaping()\n      .create()\n      .toJson(DpvVersion.fromConfig(config))\n",
