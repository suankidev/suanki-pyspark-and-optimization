    {
      "text": "%spark\nimport upickle.default.{ReadWriter, macroRW, read, write}\n\nval lineage= \"\"\"{'bomV1': {'runDate': '2024-10-10',\n  'version': '195451',\n  'versionName': '2024-10-10_195451',\n  'bucket': 's3://fx-live-billofmaterial',\n  'prefix': 'parsed/rundate=2024-10-10/version=195451'},\n 'bomV2': {'runDate': '2024-10-10',\n  'version': '184244',\n  'versionName': '2024-10-10_184244',\n  'bucket': 's3://fx-live-billofmaterial-v2',\n  'prefix': 'parsed/rundate=2024-10-10/version=184244'},\n 'bomPreseries': {'runDate': '2024-10-10',\n  'version': '195435',\n  'versionName': '2024-10-10_195435',\n  'bucket': 's3://fx-live-billofmaterial-preseries',\n  'prefix': 'parsed/rundate=2024-10-10/version=195435'},\n 'vpo': {'runDate': '2024-10-11',\n  'version': '074437',\n  'versionName': '2024-10-11_074437',\n  'bucket': 's3://fx-live-vehicleproductionorder',\n  'prefix': 'parsed/rundate=2024-10-11/version=074437'}}\"\"\"\n\n\n",
      "config": {
