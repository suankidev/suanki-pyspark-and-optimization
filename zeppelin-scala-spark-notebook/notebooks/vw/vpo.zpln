    {
      "text": "%spark\nval t=List(\n  prepareJson(Version(\n      runDate = config.runDate,\n      version = config.version,\n      versionName = s\"${config.runDate}_${config.version}\",\n      bucket = s\"s3://${config.bucket}\",\n      prefix = config.prefix)),\n        prepareJson(Version(\n      runDate = config.runDate,\n      version = config.version,\n      versionName = s\"${config.runDate}_${config.version}\",\n      bucket = s\"s3://${config.bucket}\",\n      prefix = config.prefix))\n\n)\n      ",
