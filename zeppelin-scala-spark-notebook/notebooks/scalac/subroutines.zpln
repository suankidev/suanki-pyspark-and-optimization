    {
      "text": "%spark\nobject FarAway{\n\n     def codeOne(isSunnyDay:Boolean,isRainyDay:Boolean) = {\n       println(\"About to create subroutines\")\n     if(isSunnyDay) \"I'm happy because it's sunny\"\n     else if(isRainyDay) \"I'm sad because it's raining\"\n     else \"Not sure how i feel about today\" \n     }\n\n     val  codeTwo : (Boolean,Boolean) =>String= {\n     println(\"About to create subroutines\")  //this is not available to create in code or codeOne\n     (isSunnyDay:Boolean,isRainyDay:Boolean)=>\n     if(isSunnyDay) \"I'm happy because it's sunny\"\n     else if(isRainyDay) \"I'm sad because it's raining\"\n     else \"Not sure how i feel about today\" \n     }\n\n     val  code = (isSunnyDay:Boolean,isRainyDay:Boolean) => {\n     println(\"About to create subroutines\")\n     if(isSunnyDay) \"I'm happy because it's sunny\"\n     else if(isRainyDay) \"I'm sad because it's raining\"\n     else \"Not sure how i feel about today\" \n     }\n\n\n}\n",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
