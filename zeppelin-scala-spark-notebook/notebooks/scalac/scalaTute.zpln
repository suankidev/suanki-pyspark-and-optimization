      "id": "4540fffe3ea6443f97a1f"
    },
    {
      "text": "%spark\n  var count=0\n  def aRepeatedFunction(aString: String, n: Int): String = {\n    count = count + 1\n    println(s\"running the repeated function ${count}\")\n    if (n == 1) \"hello\"\n    else {\n      println(aString)\n      aString + aRepeatedFunction(aString, n - 1) // last line should be value\n    }\n  }\n\n  println(aRepeatedFunction(\"test-\", 5))\n",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
