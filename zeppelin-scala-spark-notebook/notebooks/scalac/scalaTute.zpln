      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "5677204f9de8417da2cd6"
    },
    {
      "text": "%spark\n\ndef fact(n:Int):Int={\n  @scala.annotation.tailrec\ndef loop(n:Int,acc:Int=1):Int = {\n  if(n==1) acc\n  else \n    loop(n=n-1,acc=acc*n)\n}\nloop(n)\n}\n\nfact(4)",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
