    {
      "text": "%spark\n//this function convert dec to binary\n\ndef toBinary(x:Long):String = {\ndef loop(x:Long,accu:String):String={\n\n if(x == 0) accu\n else  loop(x/2, (x%2).toString + accu)\n\n}\nloop(x,accu=\"\")\n\n}\n\nprintln(toBinary(14))\n\n\n// 8421",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
