      "text": "%spark\n\n\nabstract class Demo{\n\n  implicit lazy val demo = \"this is test string\"\n}\n\n\nclass Test extends Demo{\n\n\ndef printIt(s:String)(implicit demo:String):Unit={\n\n  println(s + demo)\n}\n\n}\n",
