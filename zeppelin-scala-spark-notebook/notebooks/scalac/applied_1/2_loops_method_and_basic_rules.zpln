    {
      "text": "%spark\ndef sumAndDifference(a: Int, b: Int): (Int, Int) = {\n  val sum = a + b\n  val difference = a - b\n  (sum, difference)\n}\n\nval res = sumAndDifference(10, 5)\n\nval (sm, df) = sumAndDifference(10, 5)\n\nval (a,b,c,d,e) = (0, 'u', 8, 1, \"too\")\n\n\n",
      "config": {
        "colWidth": 12,
