    {
      "text": "%spark\n\ndef someMethod(x:Int):Int={\n  try{\n    x/0\n  }catch {\n    case e:NoSuchElementException => 0\n    case e:ArithmeticException => 10\n  }finally {\n    println(\"als\")\n  }\n}\n\nval x = someMethod(10)\n\nif(x == 10){\n  println(\"returned zero\")\n}",
      "config": {
