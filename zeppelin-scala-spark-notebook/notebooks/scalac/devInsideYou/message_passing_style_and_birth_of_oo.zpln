    {
      "text": "%spark\n\n\ntype bankAccount = Symbol => Any\n\nclass BankAccount(initialBalance:Int){\n  self =>\n\n  private[this] var _balance:Int = initialBalance\n\n  val withdraw:Int => Unit= amount =>{\n    if(balance >= amount)\n      this._balance = self._balance - amount\n    else\n      throw new Exception(\"Insufficient funds\")\n  }\n\n  val deposit:Int=>Unit=amount=>{\n    if(amount >= 1) {\n      _balance = _balance + amount\n    }else\n      throw new Exception(\"It's only possible to deposit positive amount_|_\")\n  }\n\n  def balance:Int={\n    self._balance\n  }\n\n}\n\nval thisOne:BankAccount = new BankAccount(initialBalance=1000)\nval thatOne:BankAccount = new BankAccount(initialBalance=1000)\n\ndef makeTransfer1(from:BankAccount,amount:Int, to:BankAccount):Unit= {\n\n   from.withdraw(amount)\n   to.deposit(amount)\n\n   println(s\"from account balance: ${from.balance}\")\n   println(s\"to account balance: ${to.balance}\")\n\n}",
      "config": {
