    {
      "text": "%spark\n\nval thisOne:bankAccount = bankAccount(initialBalance=1000)\nval thatOne:bankAccount = bankAccount(initialBalance=1000)\n\ndef makeTransfer(from:bankAccount,amount:Int, to:bankAccount):Unit= {\n\nfrom(Symbol(\"withdraw\")).asInstanceOf[Int => Unit](amount)\nto(Symbol(\"deposit\")).asInstanceOf[Int => Unit](amount)\n\nprintln(s\"from account balance: ${from(Symbol(\"getBalance\")).asInstanceOf[() => Int]()}\")\nprintln(s\"to account balance: ${to(Symbol(\"getBalance\")).asInstanceOf[() => Int]()}\")\n\n}\n",
      "config": {
