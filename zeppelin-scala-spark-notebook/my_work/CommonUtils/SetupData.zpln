{"id":"1SH094ZQ7","name":"SetupData","paragraphs":[{"text":"// dbutils.fs.ls(\"FileStore/tables/suankiData/raw/transaction\")","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/scala","editorSetting":{"params":{},"forms":{},"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"3025c3431cd049e985122","status":404},{"text":"%spark\n\nobject Setup{\n\ndbutils.fs.mkdirs(\"dbfs:/FileStore/tables/suankiData\")\ndbutils.fs.mkdirs(\"dbfs:/FileStore/tables/suankiData/raw/flightData\")\ndbutils.fs.mkdirs(\"dbfs:/FileStore/tables/suankiData/raw/retailData\")\n\n  val basePath = \"dbfs:/FileStore/tables/suankiData\"\n  val rawPath = \"dbfs:/FileStore/tables/suankiData/raw\"\n  val stage = \"dbfs:/FileStore/tables/suankiData/stage\"\n  val processedPath = \"dbfs:/FileStore/tables/suankiData/processed\"\n  val flightDataPath = s\"$basePath/raw/flightData\"\n  val retailDataPath = s\"$basePath/raw/retailData\"\n  val spotifyArtistPath = s\"$basePath/raw/spotify/Spotify_Artists.csv\"\n  val spotifyListeningActivityPath = s\"$basePath/raw/spotify/Spotify_Listening_Activity.csv\"\n  val spotifySongPath = s\"$basePath/raw/spotify/Spotify_Songs.csv\"\n\n    lazy val transactionDF = loadParquetDataSet(\"transaction.parquet\")\n    lazy val customerDF = loadParquetDataSet(\"customer.parquet\")\n    lazy val retailDF =   spark.read.option(\"inferSchema\",true).option(\"header\",true).csv(Setup.retailDataPath)\n    lazy val payementDF = CreateTables.createPaymnetTable(spark)\n    lazy val spotifyArtistDf = spark.read.option(\"inferSchema\",true).option(\"header\",true).csv(Setup.spotifyArtistPath)\n    lazy val spotifyListeningActivityDf = spark.read.option(\"inferSchema\",true).option(\"header\",true).csv(Setup.spotifyListeningActivityPath)\n    lazy val spotifySongDf = spark.read.option(\"inferSchema\",true).option(\"header\",true).csv(Setup.spotifySongPath)\n    \n    def departmentDF(spark:org.apache.spark.sql.SparkSession):org.apache.spark.sql.DataFrame={\n\n\n          val simpleData = Seq((\"James\", \"Sales\", 3000),\n              (\"Michael\", \"Sales\", 4600),\n              (\"Robert\", \"Sales\", 4100),\n              (\"Maria\", \"Finance\", 3000),\n              (\"James\", \"Sales\", 3000),\n              (\"Scott\", \"Finance\", 3300),\n              (\"Jen\", \"Finance\", 3900),\n              (\"Jeff\", \"Marketing\", 3000),\n              (\"Kumar\", \"Marketing\", 2000),\n              (\"Saif\", \"Sales\", 4100)\n            )\n\n            val df = simpleData.toDF(\"employee_name\", \"department\", \"salary\")\n            df\n\n    }\n   \n   def printPath={\n          println(s\"DataPath.basePath: ${Setup.basePath}\")\n          println(s\"DataPath.filghtData: ${Setup.flightDataPath}\")\n          println(s\"DataPath.retailData: ${Setup.retailDataPath}\")\n          println()\n          println(\"Method Available as per below\")\n          println(\" setup.loadParquetDataSet(name:String):DataFrame=spark.read.parquet(name)\")\n          println(\"transactionDF:DataFrame\")\n          println(\"customerDF:DataFrame\")\n          println(\"retailDF:DataFrame\")\n          println(\"spotifyArtistDf:DataFrame\")\n          println(\"spotifyListeningActivityDf:DataFrame\")\n          println(\"spotifySongDf:DataFrame\")\n\n   }\n\n   def loadParquetDataSet(name:String):org.apache.spark.sql.DataFrame={\n    // dbutils.fs.ls\n    spark.read.parquet(s\"$basePath/${name}\")\n   }\n\n\n}","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/scala","editorSetting":{"params":{},"forms":{},"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"0a7db798c5184dedb5fb0"},{"text":"%spark\nobject CreateTables{\n\n    def cleanupdbfs:Unit={\n\n      dbutils.fs.rm(\"/user/hive/warehouse/payment\",true)\n      dbutils.fs.rm(\"user/hive/warehouse/sk.db/payment\",true)\n\n    }\n\n    def createPaymnetTable(spark:org.apache.spark.sql.SparkSession):Unit={\n      println(\"Creating payment table\")\n      cleanupdbfs\n      spark.sql(\"\"\"create database if not exists sk\"\"\") \n      spark.sql(\"\"\"use sk\"\"\")\n      spark.sql(\"\"\"drop table if exists sk.payment\"\"\")\n      cleanupdbfs\n      spark.sql(\"\"\"  \n                           CREATE TABLE if not exists  sk.payment (payment_amount decimal(8,2), payment_date date, store_id int)\n                           USING DELTA;\n               \"\"\")\n\n      spark.sql(\n                      \"\"\"\n                      INSERT INTO payment\n                        VALUES\n                        (1200.99, '2018-01-18', 1),\n                        (189.23, '2018-02-15', 1),\n                        (33.43, '2018-03-03', 3),\n                        (7382.10, '2019-01-11', 2),\n                        (382.92, '2019-02-18', 1),\n                        (322.34, '2019-03-29', 2),\n                        (2929.14, '2020-01-03', 2),\n                        (499.02, '2020-02-19', 3),\n                        (994.11, '2020-03-14', 1),\n                        (394.93, '2021-01-22', 2),\n                        (3332.23, '2021-02-23', 3),\n                        (9499.49, '2021-03-10', 3),\n                        (3002.43, '2018-02-25', 2),\n                        (100.99, '2019-03-07', 1),\n                        (211.65, '2020-02-02', 1),\n                        (500.73, '2021-01-06', 3);\n                          \"\"\"\n                        )\n\n\n    }\n\n\n}\n\n","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/scala","editorSetting":{"params":{},"forms":{},"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"d88beb7107254c7e9e339"},{"text":"%spark\n//creating tables\n\nlazy val transactionDF = Setup.loadParquetDataSet(\"raw/transaction\")\nlazy val customerDF = Setup.loadParquetDataSet(\"raw/customer\")\nlazy val retailDF =   spark.read.option(\"inferSchema\",true).option(\"header\",true).csv(Setup.retailDataPath)\nlazy val departmentDF = Setup.departmentDF(spark)\nlazy val spotifyArtistDf= Setup.spotifyArtistDf\nlazy val spotifyListeningActivityDf = Setup.spotifyListeningActivityDf\nlazy val spotifySongDf = Setup.spotifySongDf\nSetup.payementDF\n","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/scala","editorSetting":{"params":{},"forms":{},"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"11d11aadd9c24770b6804"},{"text":"%spark\nimport org.apache.spark.sql.SparkSession\nimport org.apache.spark.sql.{functions => f}\nimport org.apache.spark.sql.functions._\nimport org.apache.spark.sql.expressions.Window ","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/scala","editorSetting":{"params":{},"forms":{},"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"6f046edfdb314fe3a5d8a"}],"info":{},"noteForms":{},"noteParams":{},"angularObjects":{}}