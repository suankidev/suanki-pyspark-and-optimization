{"id":"QCPSYHDWJ","name":"DatabricksPlatform","paragraphs":[{"text":"%python\nprint(f\"Database Name: {DA.schema_name}\")","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/python","editorSetting":{"params":{},"forms":{},"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"5e2370003f27443dbef36"},{"text":"%python\ndbutils.widgets.removeAll()","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/python","editorSetting":{"params":{},"forms":{},"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"413ae393049b4166bd94a"},{"text":"%sql\nSHOW TABLES IN ${DA.schema_name}","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/sql","editorSetting":{"params":{},"forms":{},"language":"sql","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"771f6d1712dc44fa8feaa"},{"text":"\n\n\nRender HTML using the function: **`displayHTML`** (available in Python, Scala, and R)","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/markdown","editorSetting":{"params":{},"forms":{},"language":"markdown","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"7a25242d14c84c7e899c6","status":404},{"text":"\n\n\nView your database and table in the Data tab of the UI.","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/markdown","editorSetting":{"params":{},"forms":{},"language":"markdown","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"c1f4a140dd854a869ede3","status":404},{"text":"\n\n\nLet's take one more look at our temp file...","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/markdown","editorSetting":{"params":{},"forms":{},"language":"markdown","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"a457a2367097408893957","status":404},{"text":"\n\n\n## Query table and plot results\nUse SQL to query the **`events`** table","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/markdown","editorSetting":{"params":{},"forms":{},"language":"markdown","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"b94bc0dabbcb4593947bf","status":404},{"text":"%fs help","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/plain_text","editorSetting":{"params":{},"forms":{},"language":"plain_text","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"eaf23b4d09bb4ff6bb5be","status":404},{"text":"%sql\nSELECT *\nFROM events\nWHERE geo.state = getArgument(\"state\")","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/sql","editorSetting":{"params":{},"forms":{},"language":"sql","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"19694e8ce6034d46b522c","status":404},{"text":"%python\nhtml = \"\"\"<h1 style=\"color:orange;text-align:center;font-family:Courier\">Render HTML</h1>\"\"\"\ndisplayHTML(html)","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/python","editorSetting":{"params":{},"forms":{},"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"3206f6a1bb9e49b99da5c","status":404},{"text":"%fs ls dbfs:/tmp","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/plain_text","editorSetting":{"params":{},"forms":{},"language":"plain_text","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"d2c36c4e28ed4b6a92de4","status":404},{"text":"\n\n\nRun shell commands on the driver using the magic command: **`%sh`**","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/markdown","editorSetting":{"params":{},"forms":{},"language":"markdown","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"8fafbb7fc2324c1783c46","status":404},{"text":"%spark\nprintln(\"Run scala\")","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/scala","editorSetting":{"params":{},"forms":{},"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"c6fb5e50b4f14d2e91182","status":404},{"text":"\n\n\n## Add notebook parameters with widgets\nUse <a href=\"https://docs.databricks.com/notebooks/widgets.html\" target=\"_blank\">widgets</a> to add input parameters to your notebook.\n\nCreate a text input widget using SQL.","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/markdown","editorSetting":{"params":{},"forms":{},"language":"markdown","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"fd7a91a840134c1d8ef17","status":404},{"text":"%sql\nCREATE WIDGET TEXT state DEFAULT \"CA\"","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/sql","editorSetting":{"params":{},"forms":{},"language":"sql","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"0ab4aeb46ad94eeeaaa5d","status":404},{"text":"%python\nfiles = dbutils.fs.ls(DA.paths.events)\ndisplay(files)","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/python","editorSetting":{"params":{},"forms":{},"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"20e7c63b46e24b59aa080","status":404},{"text":"%python\ndbutils.fs.ls(\"dbfs:/tmp\")","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/python","editorSetting":{"params":{},"forms":{},"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"95a9737a593746fe8a62f","status":404},{"text":"%sql\nCREATE TABLE IF NOT EXISTS events\nUSING DELTA\nOPTIONS (path = \"${whatever.events}\");","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/sql","editorSetting":{"params":{},"forms":{},"language":"sql","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"d5878469c4594100bd492","status":404},{"text":"\n\n\nRemove all widgets","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/markdown","editorSetting":{"params":{},"forms":{},"language":"markdown","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"5d351d69f04249b4bd08a","status":404},{"text":"%sh ps | grep 'java'","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/sh","editorSetting":{"params":{},"forms":{},"language":"sh","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"0b2e5bdea3424813880d0","status":404},{"text":"%sql\nSELECT traffic_source, SUM(ecommerce.purchase_revenue_in_usd) AS total_revenue\nFROM events\nGROUP BY traffic_source","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/sql","editorSetting":{"params":{},"forms":{},"language":"sql","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"9b712e9d23e342c4ab068","status":404},{"text":"\n\n\nRun file system commands on DBFS using DBUtils directly","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/markdown","editorSetting":{"params":{},"forms":{},"language":"markdown","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"abf3f8edb88b459a82dbe","status":404},{"text":"%fs mounts","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/plain_text","editorSetting":{"params":{},"forms":{},"language":"plain_text","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"254e7ba6896f4f2881bd8","status":404},{"text":"%sql\nREMOVE WIDGET state","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/sql","editorSetting":{"params":{},"forms":{},"language":"sql","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"eb75cf2a1ea34f4eb11e7","status":404},{"text":"\n\n\n... or even the tables in that database:","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/markdown","editorSetting":{"params":{},"forms":{},"language":"markdown","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"4c848888efd546f2997e5","status":404},{"text":"\n\n\n**`%fs`** is shorthand for the <a href=\"https://docs.databricks.com/dev-tools/databricks-utils.html\" target=\"_blank\">DBUtils</a> module: **`dbutils.fs`**","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/markdown","editorSetting":{"params":{},"forms":{},"language":"markdown","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"fb1429b66518421ab5733","status":404},{"text":"%python\nfile_name = \"dbfs:/tmp/FILL_IN.txt\"\ncontents = dbutils.fs.head(file_name)\n\nprint(\"-\"*80)\nprint(contents)\nprint(\"-\"*80)","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/python","editorSetting":{"params":{},"forms":{},"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"8d91f2ff4c8949eda9797","status":404},{"text":"\n\n\n## Create table\nRun <a href=\"https://docs.databricks.com/spark/latest/spark-sql/language-manual/index.html#sql-reference\" target=\"_blank\">Databricks SQL Commands</a> to create a table named **`events`** using BedBricks event files on DBFS.","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/markdown","editorSetting":{"params":{},"forms":{},"language":"markdown","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"b3b7a4a2860745a6b9150","status":404},{"text":"\n\n\n# Databricks Platform\n\nDemonstrate basic functionality and identify terms related to working in the Databricks workspace.\n\n\n##### Objectives\n1. Execute code in multiple languages\n1. Create documentation cells\n1. Access DBFS (Databricks File System)\n1. Create database and table\n1. Query table and plot results\n1. Add notebook parameters with widgets\n\n\n##### Databricks Notebook Utilities\n- <a href=\"https://docs.databricks.com/notebooks/notebooks-use.html#language-magic\" target=\"_blank\">Magic commands</a>: **`%python`**, **`%scala`**, **`%sql`**, **`%r`**, **`%sh`**, **`%md`**\n- <a href=\"https://docs.databricks.com/dev-tools/databricks-utils.html\" target=\"_blank\">DBUtils</a>: **`dbutils.fs`** (**`%fs`**), **`dbutils.notebooks`** (**`%run`**), **`dbutils.widgets`**\n- <a href=\"https://docs.databricks.com/notebooks/visualizations/index.html\" target=\"_blank\">Visualization</a>: **`display`**, **`displayHTML`**","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/markdown","editorSetting":{"params":{},"forms":{},"language":"markdown","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"3986d2c0d03d456a9c779","status":404},{"text":"%fs put dbfs:/tmp/FILL_IN.txt \"This is a test of the emergency broadcast system, this is only a test\" --overwrite=true","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/plain_text","editorSetting":{"params":{},"forms":{},"language":"plain_text","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"93e81d5c3c56416f868d2","status":404},{"text":"\n\n\n<img src=\"https://files.training.databricks.com/images/icon_note_24.png\"> In the above example we use **`whatever.`** to give our variable a \"namespace\".\n\nThis is so that we don't accidently step over other configuration parameters.\n\nYou will see throughout this course our usage of the \"DA\" namesapce as in **`DA.paths.some_file`**","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/markdown","editorSetting":{"params":{},"forms":{},"language":"markdown","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"d41392e53cb74fa5985c4","status":404},{"text":"\n\n\n### Execute code in multiple languages\nRun default language of notebook","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/markdown","editorSetting":{"params":{},"forms":{},"language":"markdown","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"c10a3a1803364124ba71d","status":404},{"text":"%python\nname = dbutils.widgets.get(\"name\")\ncolors = dbutils.widgets.get(\"colors\").split(\",\")\n\nhtml = \"<div>Hi {}! Select your color preference.</div>\".format(name)\nfor c in colors:\n    html += \"\"\"<label for=\"{}\" style=\"color:{}\"><input type=\"radio\"> {}</label><br>\"\"\".format(c, c, c)\n\ndisplayHTML(html)","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/python","editorSetting":{"params":{},"forms":{},"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"5d2c4fa9b20743aa8939b","status":404},{"text":"\n\n\nAccess the current value of the widget using the function **`getArgument`**","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/markdown","editorSetting":{"params":{},"forms":{},"language":"markdown","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"a4477982f37f4ad7aa41f","status":404},{"text":"%sql\nselect \"Run SQL\"","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/sql","editorSetting":{"params":{},"forms":{},"language":"sql","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"fff1d97692f3473598d75","status":404},{"text":"%python\nspark.conf.set(\"whatever.events\", DA.paths.events)","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/python","editorSetting":{"params":{},"forms":{},"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"b7f81e9a7c85443c80fe9","status":404},{"text":"\n\n\nRun the query below and then <a href=\"https://docs.databricks.com/notebooks/visualizations/index.html#plot-types\" target=\"_blank\">plot</a> results by clicking the plus sign (+) and selecting *Visualization*. When presented with a bar chart, click *Save* to add it to the output window.","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/markdown","editorSetting":{"params":{},"forms":{},"language":"markdown","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"bac423ea417540ecba2a1","status":404},{"text":"\n<div style=\"text-align: center; line-height: 0; padding-top: 9px;\">\n  <img src=\"https://databricks.com/wp-content/uploads/2018/03/db-academy-rgb-1200px.png\" alt=\"Databricks Learning\" style=\"width: 600px\">\n</div>","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/markdown","editorSetting":{"params":{},"forms":{},"language":"markdown","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"53bdd02f68924e25bff68","status":404},{"text":"%fs head dbfs:/tmp/FILL_IN.txt","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/plain_text","editorSetting":{"params":{},"forms":{},"language":"plain_text","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"d6515960217f4d5985866","status":404},{"text":"%python \nprint(\"Run python\")","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/python","editorSetting":{"params":{},"forms":{},"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"8668cda4562c4688a6b5c","status":404},{"text":"%spark\nprintln(\"Run default language\")","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/scala","editorSetting":{"params":{},"forms":{},"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"00c62be277114d4dbd48f","status":404},{"text":"\nRemove the text widget","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/markdown","editorSetting":{"params":{},"forms":{},"language":"markdown","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"0b48d240455b46a2a3ae4","status":404},{"text":"\n\n\n## Create documentation cells\nRender cell as <a href=\"https://www.markdownguide.org/cheat-sheet/\" target=\"_blank\">Markdown</a> using the magic command: **`%md`**\n\nBelow are some examples of how you can use Markdown to format documentation. Click this cell and press **`Enter`** to view the underlying Markdown syntax.\n\n\n# Heading 1\n### Heading 3\n> block quote\n\n1. **bold**\n2. *italicized*\n3. ~~strikethrough~~\n\n---\n\n- <a href=\"https://www.markdownguide.org/cheat-sheet/\" target=\"_blank\">link</a>\n- `code`\n\n```\n{\n  \"message\": \"This is a code block\",\n  \"method\": \"https://www.markdownguide.org/extended-syntax/#fenced-code-blocks\",\n  \"alternative\": \"https://www.markdownguide.org/basic-syntax/#code-blocks\"\n}\n```\n\n![Spark Logo](https://files.training.databricks.com/images/Apache-Spark-Logo_TM_200px.png)\n\n| Element         | Markdown Syntax |\n|-----------------|-----------------|\n| Heading         | `#H1` `##H2` `###H3` `#### H4` `##### H5` `###### H6` |\n| Block quote     | `> blockquote` |\n| Bold            | `**bold**` |\n| Italic          | `*italicized*` |\n| Strikethrough   | `~~strikethrough~~` |\n| Horizontal Rule | `---` |\n| Code            | ``` `code` ``` |\n| Link            | `[text](https://www.example.com)` |\n| Image           | `![alt text](image.jpg)`|\n| Ordered List    | `1. First items` <br> `2. Second Item` <br> `3. Third Item` |\n| Unordered List  | `- First items` <br> `- Second Item` <br> `- Third Item` |\n| Code Block      | ```` ``` ```` <br> `code block` <br> ```` ``` ````|\n| Table           |<code> &#124; col &#124; col &#124; col &#124; </code> <br> <code> &#124;---&#124;---&#124;---&#124; </code> <br> <code> &#124; val &#124; val &#124; val &#124; </code> <br> <code> &#124; val &#124; val &#124; val &#124; </code> <br>|","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/markdown","editorSetting":{"params":{},"forms":{},"language":"markdown","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"fa46f6db8e67415fa3426","status":404},{"text":"\n\n\nThis table was saved in the database created for you in classroom setup.\n\nSee database name printed below.","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/markdown","editorSetting":{"params":{},"forms":{},"language":"markdown","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"bb0a947c2c7d430f997fd","status":404},{"text":"\n\n\n## Access DBFS (Databricks File System)\nThe <a href=\"https://docs.databricks.com/data/databricks-file-system.html\" target=\"_blank\">Databricks File System</a> (DBFS) is a virtual file system that allows you to treat cloud object storage as though it were local files and directories on the cluster.\n\nRun file system commands on DBFS using the magic command: **`%fs`**\n\n<br/>\n<img src=\"https://files.training.databricks.com/images/icon_hint_24.png\"/>\nReplace the instances of <strong>FILL_IN</strong> in the cells below with your email address:","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/markdown","editorSetting":{"params":{},"forms":{},"language":"markdown","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"7afe19658218420c85907","status":404},{"text":"%python\nfiles = dbutils.fs.ls(\"dbfs:/tmp\")\ndisplay(files)","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/python","editorSetting":{"params":{},"forms":{},"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"f212f632152e4e56b95f5","status":404},{"text":"\n\n\nTo create widgets in Python, Scala, and R, use the DBUtils module: **`dbutils.widgets`**","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/markdown","editorSetting":{"params":{},"forms":{},"language":"markdown","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"a8a54456679b41b7a0549","status":404},{"text":"\n\n\nAccess the current value of the widget using the **`dbutils.widgets`** function **`get`**","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/markdown","editorSetting":{"params":{},"forms":{},"language":"markdown","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"69a11147071f4cf3a10e8","status":404},{"text":"%r\nprint(\"Run R\", quote=FALSE)","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/r","editorSetting":{"params":{},"forms":{},"language":"r","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"1fc2b235c6b84596a2cb8","status":404},{"text":"%fs ls dbfs:/tmp","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/plain_text","editorSetting":{"params":{},"forms":{},"language":"plain_text","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"854d6d575341462ab525c","status":404},{"text":"\n\n\n### Setup\nRun classroom setup to <a href=\"https://docs.databricks.com/data/databricks-file-system.html#mount-storage\" target=\"_blank\">mount</a> Databricks training datasets and create your own database for BedBricks.\n\nUse the **`%run`** magic command to run another notebook within a notebook","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/markdown","editorSetting":{"params":{},"forms":{},"language":"markdown","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"bde42e304b3448d0a9d30","status":404},{"text":"%fs\nls dbfs:/databricks-datasets/","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/plain_text","editorSetting":{"params":{},"forms":{},"language":"plain_text","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"244c4ae359774bf5a0b83","status":404},{"text":"\n\n\n## But, Wait!\nI cannot use variables in SQL commands.\n\nWith the following trick you can!\n\nDeclare the python variable as a variable in the spark context which SQL commands can access:","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/markdown","editorSetting":{"params":{},"forms":{},"language":"markdown","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"6e7bd19926d74f1da451d","status":404},{"text":"%spark\n\ndbutils.widgets.text(\"name\", \"Brickster\", \"Name\")\ndbutils.widgets.multiselect(\"colors\", \"orange\", List(\"red\", \"orange\", \"black\", \"blue\"),\"Favorite Color?\")\n\ndbutils.widgets.multiselect(\"Multiselect\", \"Yes\", List(\"Yes\",\"No\",\"Maybe\"),\"what\")","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/scala","editorSetting":{"params":{},"forms":{},"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"fd42bc06f34b42de9e289","status":404},{"text":"\n\n\nVisualize results in a table using the Databricks <a href=\"https://docs.databricks.com/notebooks/visualizations/index.html#display-function-1\" target=\"_blank\">display</a> function","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/markdown","editorSetting":{"params":{},"forms":{},"language":"markdown","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"5b1c8007595a48ba8fa20","status":404},{"text":"\n\n\nRun language specified by language magic commands: **`%python`**, **`%scala`**, **`%sql`**, **`%r`**","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/markdown","editorSetting":{"params":{},"forms":{},"language":"markdown","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"0e9cfa6db663419e8da84","status":404},{"text":"%spark\n\nval name = dbutils.widgets.get(\"name\")\nval colors = dbutils.widgets.get(\"colors\").split(\",\")\n\nvar html = s\"<div>Hi ${name}! Select your color preference.</div> $name\"\nfor(c <- colors)\n    html += s\"\"\"<label for=\"${c}\" style=\"color:${c}\"><input type=\"radio\"> ${c}</label><br>\"\"\"\n\ndisplayHTML(html)","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/scala","editorSetting":{"params":{},"forms":{},"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"cde321bb4385475da5af0"},{"text":"%sql\nshow databases","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/sql","editorSetting":{"params":{},"forms":{},"language":"sql","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"9828699e61174789b3a29"},{"text":"%sql\nSELECT * FROM events","config":{"colWidth":12,"fontSize":9,"enabled":true,"editorMode":"ace/mode/sql","editorSetting":{"params":{},"forms":{},"language":"sql","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"id":"f350eaee344b49b7864b8"}],"info":{},"noteForms":{},"noteParams":{},"angularObjects":{}}