    {
      "text": "%spark\n    import org.apache.spark.sql.functions.col\n    \n    val finalDf=spark.createDataFrame(fileDfWithIndex, finalTableSchema)\n      .where(col(\"index\").between(finalHeaderCount, finalFooterCount)).drop(\"index\")",
