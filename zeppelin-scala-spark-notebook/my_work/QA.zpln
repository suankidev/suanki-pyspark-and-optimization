    {
      "text": "%spark\nval head=\"1\"\nval foot=\"0\"\nval formatType=\"csv\"\nval path=\"dbfs:/FileStore/tables/suankiData/raw/stockCsv/ind_nifty100list.csv\"\nval feedDelim=\",\"\n\nval initialDF =         ( spark\n          .read\n          .format(formatType)\n          .option(\"sep\", feedDelim)\n          .option(\"header\", \"false\")\n          .load(path),\n        spark.sparkContext.textFile(path)\n        )\n\nval stgTableDF=      {\n  spark\n          .read\n          .format(formatType)\n          .option(\"sep\", feedDelim)\n          .option(\"header\", \"true\")\n          .load(path)\n}  ",
      "config": {
