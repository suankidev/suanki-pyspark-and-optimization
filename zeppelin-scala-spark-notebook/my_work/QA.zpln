      "id": "ec380c3fe4044850b2a66"
    },
    {
      "text": "%spark\nimport org.apache.spark.sql.{functions => f}\n\nval transactionDF = spark.read.parquet(\"dbfs:/FileStore/tables/suankiData/transaction.parquet/\")\nval customerDF = spark.read.parquet(\"dbfs:/FileStore/tables/suankiData/customer.parquet\")\n\n",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "0b13f6671eaa4014ab1b5"
    },
    {
      "text": "%spark\n    \nimport org.apache.spark.sql.types.LongType\n    \n    val headerCount: Long = if (head.isEmpty) 0l else head.toLong\n    val footerCount: Long = if (foot.isEmpty) 0l else foot.toLong\n\n    val finalHeaderCount: Long = headerCount\n    val finalFooterCount: Long = if (footerCount == 0) initialDF._1.count() else initialDF._1.count() - (headerCount + footerCount)\n\n    var finalTableSchema = stgTableDF.schema.add(\"aa\", LongType, false)\n    finalTableSchema=finalTableSchema.add(\"index\", LongType, false)\n",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
