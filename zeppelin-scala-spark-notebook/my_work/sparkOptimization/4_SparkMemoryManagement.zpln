    {
      "text": "\n![img](files/tables/suankiData/raw/images/spark_executor_memory.png)\n",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/markdown",
        "editorSetting": {
          "params": {},
