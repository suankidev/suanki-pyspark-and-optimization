      "text": "%spark\n//setting to default parallelism , assuming larg datasets\nspark.conf.set(\"spark.sql.shuffle.partitions\", spark.sparkContext.defaultParallelism)\nprint(spark.conf.get(\"spark.sql.shuffle.partitions\"))",
      "config": {
