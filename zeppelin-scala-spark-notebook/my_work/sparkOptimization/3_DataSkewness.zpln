    },
    {
      "text": "%spark\nval salted_ds2 = ds2.withColumn(\"salt\", lit(f.rand * 3).cast(\"int\"))\nval salted_ds1 = ds1.withColumn(\"rand_col\", lit((0 to 2).toArray)).withColumn(\"salt\",explode(f.col(\"rand_col\")))",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
