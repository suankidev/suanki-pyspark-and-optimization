    },
    {
      "text": "%spark\n\nbroadcastJoinedDf\n.write\n.mode(\"overwrite\")\n.format(\"noop\")\n.save(\"FileStore/tables/suankiData/processed/broadcastJoinedDf\")\n\nval endTime = System.currentTimeMillis\n\n",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
