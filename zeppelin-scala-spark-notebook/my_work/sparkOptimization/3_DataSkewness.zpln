    {
      "text": "\n#### How to handle skewed data in shuffle partitons:no of records in in partions_id\n A skewed data",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/markdown",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "markdown",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "c9c882e26e4a4eb3828be"
    },
    {
      "text": "%spark\n//to demonstrate how salting work on join on smaller datasets\n\nval ds1  = Seq(\n  (\"sujeet\",\"1\",\"mobile\",\"40000\",\"Pune\"),\n  (\"sujeet\",\"2\",\"mobile\",\"42000\",\"Pune\"),\n  (\"sujeet\",\"3\",\"mobile\",\"43000\",\"Pune\"),\n  (\"sujeet\",\"4\",\"mobile\",\"44000\",\"Pune\"),\n  (\"sujeet\",\"5\",\"mobile\",\"45000\",\"Pune\"),\n  (\"sujeet\",\"6\",\"Tv\",\"2000\",\"Pune\"),\n  (\"sujeet\",\"7\",\"TV\",\"34000\",\"Pune\"),\n  (\"sujeet\",\"8\",\"Machine\",\"17000\",\"Pune\"),\n  (\"sujeet\",\"9\",\"Almira\",\"1000\",\"Pune\"),\n  (\"sujeet\",\"10\",\"Table\",\"3000\",\"Pune\"),\n  (\"Sahil\",\"11\",\"Chair\",\"1800\",\"Solapur\")\n).toDF(\"name\",\"txn_number\",\"expenseType\",\"amnt\",\"city\").repartition(2)\n\n\nval ds2 = Seq(\n  (\"sujeet\",\"Pune\",\"india\"),\n  (\"sahil\",\"Solapur\",\"india\")\n).toDF(\"name\",\"location\",\"nation\").repartition(2)\n\n\n\n",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "8d10cbd189bb4bc28a977"
    },
    {
      "text": "%spark\nsalted_join.filter(col(\"name\") === \"sujeet\").count",
      "config": {
