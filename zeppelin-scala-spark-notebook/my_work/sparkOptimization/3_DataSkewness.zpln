          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "6aa5fbcc9e3b4502b6a3c"
    },
    {
      "text": "%spark\nspark.conf.set(\"spark.sql.autoBroadcastJoinThreshold\",-1)\nspark.conf.set(\"spark.sql.adaptive.enabled\",false)\nspark.conf.set(\"spark.sql.adaptive.skewedJoin.enabled\",false) //default is false\n",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
