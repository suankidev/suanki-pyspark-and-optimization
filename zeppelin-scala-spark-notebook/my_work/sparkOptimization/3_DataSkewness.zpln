    {
      "text": "%spark\ndf.select(  f.mean( f.col(\"amnt\") )  ,\n            f.median(f.col(\"amnt\")) , \n            f.mode(f.col(\"amnt\")) ,\n            f.skewness(f.col(\"amnt\")),\n            f.kurtosis(f.col(\"amnt\"))          \n          )\n          .show(false)\n\n//positive skewness  :  \n//negative skeweness:  \n/*\nskewenes  => mean - mode /standard deviation\n*/",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
