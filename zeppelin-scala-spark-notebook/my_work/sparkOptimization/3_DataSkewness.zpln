    {
      "text": "%spark\ntransactionDF.join(customerDF.drop(\"city\"), Seq(\"cust_id\"), \"inner\")\n.withColumn(\"partitions\",f.spark_partition_id())\n.groupBy(\"partitions\")\n.count()\n.orderBy(\"partitions\")\n.show()\n\n// 1 job and 4 stage\n// stage-1  : reading customerdf\n//stage-2 : reading trandf\n//stage-3 : join of cust and tran\n//stage-4: orderby partion",
      "config": {
