      "id": "12a372df1c8d49979366e"
    },
    {
      "text": "1. similar size partiton..all the available cores in use\n\n![img](files//tables/suankiData/raw/images/similar_size_partition.png)",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/markdown",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "markdown",
