    },
    {
      "text": "%spark\nretailDF.groupBy(\"country\")\n.agg(f.mean(f.col(\"quantity\")), f.median(f.col(\"quantity\")),f.mode(f.col(\"quantity\")), f.avg(f.col(\"quantity\")))\n.show()",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
