      "id": "09fe5db96c4d415d9d44c"
    },
    {
      "text": "\n### Enable skewd join",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/markdown",
        "editorSetting": {
          "params": {},
          "forms": {},
