    {
      "text": "%spark\nval joinCond = salted_ds1.col(\"city\") === salted_ds2.col(\"location\")  && salted_ds1.col(\"salt\") === salted_ds2.col(\"salt\")\nval salted_join = salted_ds1.join(salted_ds2.drop(\"name\"), joinCond, \"inner\")",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
