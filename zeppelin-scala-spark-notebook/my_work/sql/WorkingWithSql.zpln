    },
    {
      "text": "%sql\nSELECT\n    product_id,\n    product_name,\n    list_price\nFROM\n    products\nWHERE\n    list_price = ( select max(list_price) from products);",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/sql",
        "editorSetting": {
          "params": {},
          "forms": {},
