    },
    {
      "text": "%sql\nwith temp as (select name, collect_set(s_city) as s, collect_set(d_city) as d from custTravelTab  group by name)\nselect name, concat(s,d) as city, array_distinct(concat(s,d)) as distinct_city,size(array_distinct(concat(s,d))) -1 as size from temp",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/sql",
        "editorSetting": {
