      },
      "id": "a1e2a64728084cbc841e9"
    },
    {
      "text": "%sql\nSELECT\n    first_name,\n    last_name,\n    email,\n    'contact'\nFROM\n    contacts\n\nUNION \n\nSELECT\n    first_name,\n    last_name,\n    email,\n    'employee'\nFROM\n    employees\n\nORDER BY last_name;",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/sql",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "sql",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "b55492d34796491e84d69"
    },
    {
      "text": "%sql\nSELECT\n    last_name\nFROM\n    contacts\nMINUS\nSELECT\n    last_name\nFROM\n    employees\nORDER BY\n    last_name;",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/sql",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "sql",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "c330b35dd0db484db4f44"
    },
    {
      "text": "The DISTINCT treats NULL values to be duplicates of each other. If you use the SELECT DISTINCT statement to query data from a column that has many NULL values, the result set will include only one NULL value.",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/markdown",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "markdown",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "19379db0b9a14eacbe7da"
    },
    {
      "text": "\n\nThe orders table stores the order’s header information and the order_items table stores the order line items.\n\nThe orders table links to the order_items table via the order_id column. It means that for each row in the orders table, you can find one or more rows in the order_items with the same values in the order_id column.",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/markdown",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "markdown",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "7fa4e5994d0d42ef90b63"
    },
    {
      "text": "###  Group by\n```\nSELECT \n   column_list \nFROM \n  T \nWHERE \n   condition\nGROUP BY c1, c2, c3;\nThe GROUP BY clause groups rows by values in the grouping \ncolumns such as c1, c2 and c3. The GROUP BY clause must contain only aggregates or grouping columns.\n\n\n```",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/markdown",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "markdown",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "3a1bcc8c99414d6a97c90"
    },
    {
      "text": "%sql\n\nSELECT\n    product_name,\n    list_price\nFROM\n    products\nWHERE\n    list_price > ANY(\n        SELECT\n            true\n        FROM\n            products\n        WHERE\n            category_id = 1\n    )\nORDER BY\n    product_name;",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/sql",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "sql",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "98f0a8d329d34fe8b80b0"
    },
    {
      "text": "%sql\n--finds all customers who have not yet placed an order in 2017\n\nselect customer_id, name , credit_limit from customers where customer_id not in (\n  select customer_id from orders where extract(year from order_date)=2017\n);",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/sql",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "sql",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "f29986fad34c42a1892e2"
    },
    {
      "text": "%sql\n\nSELECT\n    employee_id,\n    first_name,\n    last_name\nFROM\n    employees\nWHERE\n    employee_id IN(\n        SELECT\n            salesman_id\n        FROM\n            orders\n        INNER JOIN order_items\n                USING(order_id)\n        WHERE\n            status = 'Shipped'\n        GROUP BY\n            salesman_id,\n            EXTRACT(\n                YEAR\n            FROM\n                order_date\n            )\n        HAVING\n            SUM( quantity * unit_price )  >= 1000000  \n            AND EXTRACT(\n                YEAR\n            FROM\n                order_date) = 2017\n            AND salesman_id IS NOT NULL\n    )\nORDER BY\n    first_name,\n    last_name;",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/sql",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "sql",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "195f9ee7aaf64030a7ad7"
    },
    {
      "text": "%sql\n--tatement finds all customers who have no order:\nSELECT\n    name\nFROM\n    customers\nWHERE\n    NOT EXISTS (\n        SELECT\n            NULL\n        FROM\n            orders\n        WHERE\n            orders.customer_id = customers.customer_id\n    )\nORDER BY\n    name;",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/sql",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "sql",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "331ca807eb2643a8a6866"
    },
    {
      "text": "%sql\nselect * from products",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/sql",
        "editorSetting": {
