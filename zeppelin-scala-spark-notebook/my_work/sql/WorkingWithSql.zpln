    {
      "text": "%sql\nSELECT\n    product_name,\n    list_price\nFROM\n    products\nWHERE\n    list_price = ANY(a) from value (\n        2200,\n        2259.99,\n        2269.99\n    ) as a\n    AND category_id = 1;",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
