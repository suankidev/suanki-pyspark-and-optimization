    },
    {
      "text": "%sql\nUPDATE\n    warehouses w\nSET\n    warehouse_name = warehouse_name || ', USA'\nWHERE\n    EXISTS (\n        SELECT\n            1\n        FROM\n            locations\n        WHERE\n            country_id = 'US'\n            AND location_id = w.location_id\n    );\n\n\n    --verify\n\n    SELECT\n\twarehouse_name\nFROM\n\twarehouses\nINNER JOIN locations\n\t\tUSING(location_id)\nWHERE\n\tcountry_id = 'US';",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/sql",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "sql",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "49d3ee14a7c9425581724"
    },
    {
      "text": "%sql\n\n--in select clause\nSELECT\n    product_id,\n    product_name,\n    standard_cost,\n    ROUND(\n        (\n            SELECT\n                AVG( standard_cost )\n            FROM\n                products\n            WHERE\n                category_id = p.category_id\n        ),\n        2\n    ) avg_standard_cost\nFROM\n    products p\nORDER BY\n    product_name;",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/sql",
