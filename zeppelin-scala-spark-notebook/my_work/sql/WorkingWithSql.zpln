      "text": "%sql\n\nSELECT\n    order_id,\n    customer_id,\n    status,\n    salesman_id,\n    order_date\nFROM\n    orders\nWHERE\n    (\n        status = 'Canceled'\n        OR status = 'Pending'\n    )\n    AND customer_id = 44\nORDER BY\n    order_date;",
