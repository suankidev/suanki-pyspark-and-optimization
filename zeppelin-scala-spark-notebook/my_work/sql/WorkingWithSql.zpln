    },
    {
      "text": "%sql\n--The following query uses the LIMIT clause to get the top 5 products with the highest inventory level:\n\nselect p.product_id, p.product_name, i.quantity\nfrom products p inner join inventories i on p.product_id=i.product_id \norder by i.quantity desc limit 5\n",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/sql",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "sql",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "04cd623eccdd438eb8b73"
    },
    {
      "text": "%sql\nwith temp as ( select \n order_id ,\nsum(quantity*unit_price) as totalPrice \n from order_items \n group by order_id\n  order by totalPrice desc\n   )\nselect * from temp limit 10\n;",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/sql",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "sql",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
