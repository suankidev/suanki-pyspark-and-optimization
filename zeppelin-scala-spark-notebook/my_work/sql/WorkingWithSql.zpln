      "id": "ac08a36e0b214c3abc2c7"
    },
    {
      "text": "%spark\n\nval custTravelDf = Seq(\n  (\"aniket\",  \"pune\"    ,\"mumbai\"),\n  (\"aniket\" ,  \"mumbai\"  ,\"pune\"),\n (\"sanket\",  \"nashik\"  ,\"mumbai\"),\n (\"sanket\",  \"mumbai\"  ,\"surat\"),\n (\"vikas\",   \"pune\"    ,\"pune\"),\n (\"bharat\",  \"pune\"   ,\"nashik\")\n )\n .toDF(\"name\",\"s_city\",\"d_city\")\n \n custTravelDf.createOrReplaceTempView(\"custTravelTab\")\n /**\n output:\n \nname    count\naniket  1\nsanket  2\nvikas   0\nbharat  1```\n**/",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
