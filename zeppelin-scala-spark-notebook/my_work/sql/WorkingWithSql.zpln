      "id": "cd746a7dc24743969a983"
    },
    {
      "text": "%sql\n--To find the orders whose values are greater than 1 million, you add a HAVING clause as follows:\n\nSELECT\n    order_id,\n    SUM( unit_price * quantity ) order_value\nFROM\n    order_items\nGROUP BY\n    order_id\nHAVING\n  order_value > 1000000\nORDER BY\n    order_value DESC;\n",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/sql",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "sql",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "46c4ef728e754361be2e3"
    },
    {
      "text": "%sql\nselect product_name, list_price, avg(list_price) over(partition by category_id order by product_name)  as rnk from products limit 5",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/sql",
        "editorSetting": {
          "params": {},
          "forms": {},
