    },
    {
      "text": "%sql\n--Selecting rows that are in a list of values\n--can be written as  category_id = 1 OR category_id = 4 , may be this : category_id IN(1, 4)\nSELECT\n    product_name,\n    category_id\nFROM\n    products\nWHERE\n    category_id IN(1, 4)\nORDER BY\n    product_name;",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/sql",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "sql",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "a89b2f7303e44590998ef"
    },
    {
      "text": "%sql\n\n--For each product from the products table,  spark has to execute correlated subquery to calculate the average price by category.\nSELECT\n    product_id,\n    product_name,\n    list_price\nFROM\n    products p\nWHERE\n    list_price > (\n        SELECT\n            AVG( list_price )\n        FROM\n            products\n        WHERE\n            category_id = p.category_id\n    );",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/sql",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "sql",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "7e2c4401c9604e15918e8"
    },
    {
      "text": "%sql\n-- find customer name and his address , along with order descripion and order date\nselect c.name, c.address , o.status\nfrom \ncustomers c inner join orders o\non o.customer_id=c.customer_id  where o.status=\"Pending\";",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/sql",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "sql",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "735f6235d21f44a78b0ba"
    },
    {
      "text": "%spark\n",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
