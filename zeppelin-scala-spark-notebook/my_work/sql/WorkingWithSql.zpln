    {
      "text": "%sql\n--The following statement shows how to join three tables:orders, order_items, and customers\nSELECT\n  name AS customer_name,\n  order_id,\n  order_date,\n  item_id,\n  quantity,\n  unit_price\nFROM\n  orders\nINNER JOIN order_items USING(order_id)\nINNER JOIN customers USING(customer_id)\nORDER BY\n  order_date DESC,\n  order_id DESC,\n  item_id ASC;\n",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/sql",
