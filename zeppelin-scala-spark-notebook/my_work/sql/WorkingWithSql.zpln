      },
      "id": "852bd378c96b4609933e1"
    },
    {
      "text": "%sql\nselect \nd.first_name as manger,\ne.first_name as employee_name\nfrom employees e \ninner join employees d\non e.employee_id = d.MANAGER_ID ",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/sql",
        "editorSetting": {
          "params": {},
