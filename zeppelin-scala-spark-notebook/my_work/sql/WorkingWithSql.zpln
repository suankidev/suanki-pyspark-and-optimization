    {
      "text": "%sql\n--little complex \nSELECT\n    order_id,\n    COUNT( item_id ) item_count,\n    SUM( unit_price * quantity ) total\nFROM\n    order_items\nGROUP BY\n    order_id\nHAVING\n    SUM( unit_price * quantity ) > 500000 AND\n    COUNT( item_id ) BETWEEN 10 AND 12\nORDER BY\n    total DESC,\n    item_count DESC;",
      "config": {
        "colWidth": 12,
