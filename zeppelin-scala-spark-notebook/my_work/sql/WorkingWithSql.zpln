    },
    {
      "text": "%sql\n--month wise and category wise total sales\nwith temp as(\nSELECT\n\tname AS customer_name,\n\torder_id,\n\torder_date,\n\titem_id,\n\tproduct_name,\n\tquantity,\n\tunit_price,\n\tCATEGORY_ID,\n  order_date,\n  extract(month from order_date) as month\nFROM\n\torders\nINNER JOIN order_items\n\t\tUSING(order_id)\nINNER JOIN customers\n\t\tUSING(customer_id)\nINNER JOIN products\n\t\tUSING(product_id)\n    )\n    select month,CATEGORY_ID, sum(quantity*unit_price) as total_sale from temp  group by month , CATEGORY_ID;",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/sql",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "sql",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "319387d8c02b45888b8a7"
    },
    {
      "text": "%sql\nSELECT\n    product_name,\n    list_price,\n    ROUND(\n        (\n            SELECT\n                AVG( list_price )\n            FROM\n                products p1\n            WHERE\n                p1.category_id = p2.category_id\n        ),\n        2\n    ) avg_list_price\nFROM\n    products p2\nORDER BY\n    product_name;\n\n--In this example, we used a subquery in the SELECT clause to get the average product’s list price. Oracle evaluates the subquery for each row selected by the outer query.",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/sql",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "sql",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "3b5dfdc07c2a4637bad0c"
    },
    {
      "text": "%sql\n-- The DISTINCT clause is used in a SELECT statement to filter duplicate rows in the result set. It ensures that rows returned are unique for the column or columns specified in the SELECT clause.\n\nSELECT DISTINCT\n  first_name\nFROM\n  contacts\nORDER BY\n  first_name;",
      "config": {
