    },
    {
      "text": "%sql\n--he following statement returns the top 10 orders with the highest values:\nSELECT\n    order_id,\n    order_value\nFROM\n    (\n        SELECT\n            order_id,\n            SUM( quantity * unit_price ) order_value\n        FROM\n            order_items\n        GROUP BY\n            order_id\n        ORDER BY\n            order_value DESC\n    ) limit 10",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/sql",
        "editorSetting": {
