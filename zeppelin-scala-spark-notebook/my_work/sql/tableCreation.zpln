    {
      "text": "%sql\n\ncreate database if not exists stg_db location '/FileStore/tables/suankiData/stage' ;\ncreate database if not exists transform_db location '/FileStore/tables/suankiData/transformed' ;\ncreate database if not exists processed_db location '/FileStore/tables/suankiData/processed' ;\n",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/sql",
        "editorSetting": {
          "params": {},
