    {
      "text": "%spark\n//upload oracleData file\nval tableList = {\n    List(\n      \"regions\",\n      \"countries\",\n      \"locations\",\n      \"warehouses\",\n      \"employees\",\n      \"product_categories\",\n      \"products\",\n      \"customers\",\n      \"contacts\",\n      \"orders\",\n      \"order_items\",\n      \"inventories\"\n    )\n  }\nfor(loc <- tableList){\n  dbutils.fs.mkdirs(s\"/FileStore/tables/suankiData/raw/oracleData/$loc\")\n}\n\n//now upload the files",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
