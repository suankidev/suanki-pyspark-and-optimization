    {
      "text": "%spark\nval regions = spark.read.parquet(\"/FileStore/tables/suankiData/raw/oracleData/regions\")\nval countries = spark.read.parquet(\"/FileStore/tables/suankiData/raw/oracleData/countries\")\nval locations = spark.read.parquet(\"/FileStore/tables/suankiData/raw/oracleData/locations\")\nval warehouses = spark.read.parquet(\"/FileStore/tables/suankiData/raw/oracleData/warehouses\")\nval employees = spark.read.parquet(\"/FileStore/tables/suankiData/raw/oracleData/employees\")\nval product_categories = spark.read.parquet(\"/FileStore/tables/suankiData/raw/oracleData/product_categories\")\nval products = spark.read.parquet(\"/FileStore/tables/suankiData/raw/oracleData/products\")\nval customers = spark.read.parquet(\"/FileStore/tables/suankiData/raw/oracleData/customers\")\nval contacts = spark.read.parquet(\"/FileStore/tables/suankiData/raw/oracleData/contacts\")\nval orders = spark.read.parquet(\"/FileStore/tables/suankiData/raw/oracleData/orders\")\nval order_items = spark.read.parquet(\"/FileStore/tables/suankiData/raw/oracleData/order_items\")\nval inventories = spark.read.parquet(\"/FileStore/tables/suankiData/raw/oracleData/inventories\")",
      "config": {
