    {
      "text": "%spark\nregions.createOrReplaceTempView(\"regions\")\ncountries.createOrReplaceTempView(\"countries\")\nlocations.createOrReplaceTempView(\"locations\")\nwarehouses.createOrReplaceTempView(\"warehouses\")\nemployees.createOrReplaceTempView(\"employees\")\nproduct_categories.createOrReplaceTempView(\"product_categories\")\nproducts.createOrReplaceTempView(\"products\")\ncustomers.createOrReplaceTempView(\"customers\")\norders.createOrReplaceTempView(\"orders\")\norder_items.createOrReplaceTempView(\"order_items\")\ninventories.createOrReplaceTempView(\"inventories\")",
