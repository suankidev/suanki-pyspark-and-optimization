    },
    {
      "text": "%spark\ndbutils.fs.mkdirs(\"/FileStore/tables/suankiData/stage\")\ndbutils.fs.mkdirs(\"/FileStore/tables/suankiData/transformed\")\ndbutils.fs.mkdirs(\"/FileStore/tables/suankiData/processed\")\ndbutils.fs.mkdirs(\"FileStore/tables/suankiData/raw\")",
