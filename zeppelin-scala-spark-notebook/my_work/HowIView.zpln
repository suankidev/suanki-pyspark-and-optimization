      "text": "%spark\n\ncustTravelDf\n.groupBy(\"name\")\n.agg(\n    collect_set(col(\"s_city\")).alias(\"s\"),\n    collect_set(\"d_city\").alias(\"d\")\n  )\n.withColumn(\"combined_city\", concat(col(\"d\"),col(\"s\")))\n.withColumn(\"count\", size(array_distinct(col(\"combined_city\")))-1)\n.show(false)",
