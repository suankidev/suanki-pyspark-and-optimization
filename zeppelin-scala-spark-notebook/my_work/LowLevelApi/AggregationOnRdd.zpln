    {
      "text": "%spark\nval keyedChars = distinctChars.map(c => (c, new Random().nextDouble()))\nval outputPartitions = 10\nKVcharacters.join(keyedChars).collect    //96\nKVcharacters.join(keyedChars, outputPartitions).collect",
