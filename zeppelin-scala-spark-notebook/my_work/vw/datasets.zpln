    {
      "text": "%spark\ndef checkIfCountExceedHundred(t:Int) = if(t > 100) true else false\n\nval flightDsWithAdditionalCol = flightDs\n.map(\n  row =>\n\n  FlightWithAdditionalCol(\n     row.dest_country_name,\n     row.origin_country_name,\n     row.count,\n     checkIfCountExceedHundred(row.count.toInt)\n  )\n \n)",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
