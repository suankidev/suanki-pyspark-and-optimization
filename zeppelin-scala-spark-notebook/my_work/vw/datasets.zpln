      "id": "c7a31c921f054deeb12d8"
    },
    {
      "text": "%spark\nimport org.apache.spark.sql.functions._\n\ndef myudf = udf( (a:List[String],b:List[String]) => {\n    b.forall(x => a.contains(x))\n   }\n)\n\ndf\n.withColumn(\"size1\",size(col(\"genreList1\")))\n.withColumn(\"size2\",size(col(\"genreList2\")))\n.withColumn(\"genermatched\", array_sort(col(\"genreList1\")) === (array_sort(col(\"genreList2\"))))\n.withColumn(\"test\", forall(col(\"genreList2\") , x => array_contains(col(\"genreList1\"),x)).and(size(col(\"genreList1\")) === size(col(\"genreList2\"))))\n.show(false)",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "872f1341cdc7462f898ce"
    },
