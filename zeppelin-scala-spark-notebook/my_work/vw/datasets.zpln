      "id": "f64e65ca658049fc8958a"
    },
    {
      "text": "%spark\nval flightDf = spark\n.read\n.option(\"header\",true)\n.csv(\"dbfs:/FileStore/tables/suankiData/raw/flightData/2010_summary.csv\")\n\nflightDf.show(2,false)",
      "config": {
