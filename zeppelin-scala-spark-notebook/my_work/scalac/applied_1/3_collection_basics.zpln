      "text": "%spark\ntrait AppliedTrait {\n  \n  implicit class prnt(x: Any) {\n    def show: Unit = x match {\n      case it: String      => println(x)\n      case it:List[_] => println(x)\n      case it: Iterable[_] => println(it.mkString(\", \"))\n      case it: Iterator[_] => println(it.mkString(\", \"))\n      case _               => println(x)\n    }\n\n}\n\n}",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
