      },
      "id": "d7bbd3ad9e914f6682061"
    },
    {
      "text": "%spark\ndef traitIterable: Unit = {\n\n    \"Iterable trait example\".show\n\n    val xs: List[Int] = List(1, 2, 3, 4, 5)\n\n    xs.iterator.show\n\n    // Other Iterators:\n    xs.grouped(2).show\n    xs.sliding(2).show\n\n    println(\"subcollections of Iterable\")\n    xs.withFilter(_ % 2 == 0).map(_ * 2).show\n    xs.filter(_ % 2 == 0).map(_ * 2).show\n    xs.withFilter(_ % 2 == 0).show\n    xs.filterNot(_ % 2 == 0).map(_ * 2).show\n\n    xs.drop(2).show          // drop first 2 elements\n    xs.take(2).show          // take first 2 elements\n    xs.slice(1, 3).show      // take elements from index 1 to 2 (exclusive)\n    xs.dropWhile(_ < 3).show // drop elements while condition is true\n    xs.takeWhile(_ < 3).show // take elements while condition is true\n\n    \"subdivisions of Iterable\".show\n    xs.view.show            // lazy view of the collection\n    xs.view.map(_ * 2).show // lazy view with transformation\n    xs.view.filter(_ % 2 == 0).show // lazy view with filtering\n\n    xs.partition(_ % 2 == 0).show\n    xs.groupBy(_ % 2 == 0).show\n    xs.groupMap(_ % 2 == 0)(_ * 2).show\n    xs.groupMapReduce(_ % 2 == 0)(_ * 2)(_ + _).show\n\n    println(\"element Condition\")\n    // i want the sum even and odd numbers from the list\n    val t = xs\n      .groupBy(_ % 2 == 0)\n      .view\n      .mapValues(_.sum)\n\n    t.show\n\n    xs.map(x => (x, 1)).groupMapReduce(_._1 % 2 == 0)(_._1 * 1)(_ + _).show\n\n    xs.iterator.forall((x: Int) => x >= 1).show\n    xs.count((x: Int) => x % 2 == 0).show\n\n    // write ananymous literal\n    val x  = (a: Int) => a % 2 == 0\n    val x1 = (a: Int) => a % 2 == 20\n\n    xs.exists(x).show\n    xs.exists(x1).show\n\n    \"Folds\".show\n    xs.foldLeft(0)((x, y) => x + y).show\n    xs.foldRight(0)((x, y) => x + y).show\n    xs.reduce((x, y) => x + y)\n\n    \"specific Folds\".show\n\n    xs.show\n    xs.sum.show\n    xs.product.show\n\n    xs.min.show\n    xs.max.show\n\n    val s = new StringBuilder(\"jello\")\n    s.show\n    s.addString(new StringBuilder(\"Sham\")).show\n\n\n  val xy = List(23,45,67,89)\n\n  xs.zip(xy).show\n\n\n  xs.zipAll(xy,99,100).show\n\n  xy.zipWithIndex.show\n  xy.view\n\n  }\n\n  def code: () => Unit = { () =>\n    {\n      traitIterable\n\n    }\n  }\n",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
