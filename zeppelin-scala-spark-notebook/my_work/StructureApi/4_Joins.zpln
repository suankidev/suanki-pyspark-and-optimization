    {
      "text": "%spark\n  //“emp” dataset’s “emp_dept_id” with value 50 doesn’t have a record on “dept” hence dept columns have null and “dept_id” 30 doesn’t have a record in “emp” hence you see null’s on emp columns\n  empDF.join(deptDF,empDF(\"emp_dept_id\") ===  deptDF(\"dept_id\"),\"full\")\n    .show(false)",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
