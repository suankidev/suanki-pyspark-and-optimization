      "id": "ac51a5aa5d2e4292b4623"
    },
    {
      "text": "%spark\nspark",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
