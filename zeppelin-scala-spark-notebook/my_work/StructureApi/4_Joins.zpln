      "text": "%spark\n\nval dept = Seq((\"Finance\",10),\n    (\"Marketing\",20),\n    (\"Sales\",30),\n    (\"IT\",40),\n    (\"IT\",40),\n  )\n\n  val deptColumns = Seq(\"dept_name\",\"dept_id\")\n  val deptDF = dept.toDF(deptColumns:_*)\n  deptDF.show(false)",
