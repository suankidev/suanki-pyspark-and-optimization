    {
      "text": "%spark\nperson.withColumnRenamed(\"id\", \"personId\")\n.join(sparkStatus, expr(\"array_contains(spark_status, id)\")).show()",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
