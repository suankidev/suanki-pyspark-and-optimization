      "id": "bddef6ed82214b5993c6a"
    },
    {
      "text": "%spark\nval gradProgramDupe = graduateProgram.withColumnRenamed(\"id\", \"graduate_program\")\nval joinExpr = gradProgramDupe.col(\"graduate_program\") === person.col(\"graduate_program\")\n\nperson.join(gradProgramDupe, joinExpr).show()\n\n//The challenge arises when we refer to one of these columns:\n\nperson.join(gradProgramDupe, joinExpr).select(\"graduate_program\").show()  //`graduate_program` is ambiguous, could be: [`graduate_program`, `graduate_program`].",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "1f1461a4b5fe479fb32d8"
    },
    {
      "text": "%spark\n val emp = Seq((1,\"Smith\",-1,\"2018\",\"10\",\"M\",3000),\n    (2,\"Rose\",1,\"2010\",\"20\",\"M\",4000),\n    (3,\"Williams\",1,\"2010\",\"10\",\"M\",1000),\n    (4,\"Jones\",2,\"2005\",\"10\",\"F\",2000),\n    (5,\"Brown\",2,\"2010\",\"40\",\"\",-1),\n      (6,\"Brown\",2,\"2010\",\"50\",\"\",-1)\n  )\n\n\n  val empColumns = Seq(\"emp_id\",\"name\",\"superior_emp_id\",\"year_joined\",\n       \"emp_dept_id\",\"gender\",\"salary\")\n  import spark.sqlContext.implicits._\n  val empDF = emp.toDF(empColumns:_*)\n  empDF.show(false)\n\nval d = sc.parallelize(emp)\n\nd.collect\n// val datframe = spark.createDataFrame(empDF.rdd, empDF.schema)\n// val datframe = spark.createDataFrame(d, empDF.schema)\n\n",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
