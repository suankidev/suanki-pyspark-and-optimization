    {
      "text": "%spark\n/**\nIf you use the GROUP BY like this, you need multiple UNION ALL clauses to combine the data from different sources. UNION ALL also requires all result sets to have the same number of columns with compatible data types, so you need to adjust the queries by adding a NULL value where required\n*/\nspark.sql(\"\"\"\n--calculate sum of total payemnt , for each year and storeid\nwith temp as (select payment_amount as paymentAmount, year(payment_date) as payementYear, store_id as storeId from payment)\nselect sum(paymentAmount), payementYear, null as storeid from temp  group by  payementYear  \nunion\nselect sum(paymentAmount), null as payementYear, storeid from temp  group by  storeid  \n\"\"\").show()",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "scala",
          "editOnDblClick": false,
