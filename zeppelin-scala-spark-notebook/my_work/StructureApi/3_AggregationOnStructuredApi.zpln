      "text": "%sql\nSELECT name, salary,\n    LAG(salary) OVER (PARTITION BY dept ORDER BY salary) AS lag,\n    LEAD(salary, 1, 0) OVER (PARTITION BY dept ORDER BY salary) AS lead\n    FROM employees;",
