    {
      "text": "%spark\nspark.sql(\"\"\"\nwith temp as(select payment_amount as paymentAmount, year(payment_date) as payementYear, store_id as storeId from payment)\nSELECT\n  SUM(paymentAmount),\n  payementYear,\n  storeId\nFROM temp\nGROUP BY  grouping sets(\n(payementYear, storeId),\n(payementYear),\n(storeId))\nORDER BY payementYear, storeId;\n\"\"\").show()",
