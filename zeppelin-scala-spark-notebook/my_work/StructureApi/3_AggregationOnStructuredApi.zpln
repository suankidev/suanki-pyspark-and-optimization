    },
    {
      "text": "\n###Spark Window Functon on sql by spark doc\n\n- https://spark.apache.org/docs/latest/sql-ref-syntax-qry-select-window.html\n",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/markdown",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "markdown",
