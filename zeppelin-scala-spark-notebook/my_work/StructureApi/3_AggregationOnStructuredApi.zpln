    {
      "text": "%spark\nval finaldf = paydf.cube(col(\"payementYear\"), col(\"storeId\"))\n.agg(f.grouping_id().as(\"gid\"), f.sum(f.col(\"paymentAmount\")).as(\"sumAmount\"))\n.orderBy(col(\"payementYear\").desc, col(\"storeId\").desc)\n\nfinaldf.show()",
      "config": {
