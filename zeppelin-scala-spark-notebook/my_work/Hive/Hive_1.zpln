    {
      "text": "%sql\n--check if partitions already exists\nINSERT OVERWRITE TABLE zipcodes PARTITION(state='NJ') \nIF NOT EXISTS VALUES (921,'US','New Jersey',7097);\n\nINSERT OVERWRITE TABLE zipcodes PARTITION(state='NJ') \nIF NOT EXISTS select id,city,zipcode from other_table;",
