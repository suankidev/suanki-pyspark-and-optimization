    {
      "text": "%sql\n-- 1. Create a table with a strict, readable S3 path\ndrop table if exists stg_db.external_table_path;\nCREATE TABLE stg_db.external_table_path (\n    id INT,\n    message STRING\n)\nusing PARQUET\nLOCATION 's3://suanki-databricks-space/suankiData/stage/external_table_path';\n\n-- 2. Insert data\nINSERT INTO stg_db.external_table_path VALUES (1, 'Clean path!');\n",
      "config": {
