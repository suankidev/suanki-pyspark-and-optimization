      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "d771e46cc4d748ad83858"
    },
    {
      "text": "%sql\n\n--mapside join vs reduce side join\n--by default it's map side join\n-- set hive.auto.convert.join=true  \n--hive,mapjoin.smalltable.filesize=2500000 if small table size is below this then consider map join\n-- meaning smaller table would be cached  to every node and would be join\n\n\n\n\n",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/sql",
