    },
    {
      "text": "%sql\ndescribe formatted stg_db.createdWithSparkSql;\n\n--so, by default table is created under dbfs:/FileStore/tables/suankiData/stage/createdwithsparksql since ,we have setup this as warehouse location",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
