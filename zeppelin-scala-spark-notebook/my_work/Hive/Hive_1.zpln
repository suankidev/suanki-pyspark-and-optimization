    {
      "text": "%sql\nCREATE DATABASE IF NOT EXISTS stg_db \nMANAGED LOCATION 's3://suanki-databricks-space/suankiData/stage';\n\nCREATE DATABASE IF NOT EXISTS transform_db \nMANAGED LOCATION 's3://suanki-databricks-space/suankiData/transformed';\n\nCREATE DATABASE IF NOT EXISTS processed_db \nMANAGED LOCATION 's3://suanki-databricks-space/suankiData/processed';\n\n",
