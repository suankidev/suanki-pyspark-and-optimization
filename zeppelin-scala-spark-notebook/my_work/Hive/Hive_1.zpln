    {
      "text": "%sql\nINSERT INTO transform_db.suanki_employee_partitioned PARTITION(DEPARTMENT_ID) \nselect  \ncast(EMPLOYEE_ID as int) as id,\nconcat(FIRST_NAME,Last_name) as full_name,\nEMAIL,\nPHONE_NUMBER,\nto_date(hire_date,'yyyy-MM-dd') as hire_date,\ncast(JOB_ID as int) as job_id,\ncast(SALARY as DOUBLE) as salary,\ncast(MANAGER_ID as int) as manager_id,\nDEPARTMENT_ID\n FROM stg_db.suanki_employee_stg where EMPLOYEE_ID is not NULL\n\n -->wrong data ",
      "config": {
