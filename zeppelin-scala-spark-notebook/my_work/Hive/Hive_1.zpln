    {
      "text": "\n//load data will copy the file into hive table location, here file will be not moved to table location only copied from locat to hdfs tbale location\n//if you run below command more than one..itw will just make copy_1, copy_2....\nload data local inpath  \"somepath\"  into table swcstg   //during table creation we have define delimmited and line termination\nload data local inpath  \"somepath\"  overwrite into table swcstg    //by default it wiil append without overwrite\n\n//from hdfs once you load the data file will be moved from sometest to table location (mind it)\n\nload data inpath '/somtest/test_file.csv' into table swcstg\nload data inpath '/somtest/test_file.csv' overwrite into table swcstg\n\n",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/markdown",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "markdown",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "671e94558c504db2b1615"
    },
    {
      "text": "%sql\n--creating partitioned table\ndrop table if exists transform_db.suanki_employee_partitioned;\ncreate external table transform_db.suanki_employee_partitioned(\n  id int,\n  full_name String,\n  EMAIL string,\n  phone_number string,\n  HIRE_DATE date,\n  JOB_ID string,\n  SALARY double,\n  MANAGER_ID int\n)\npartitioned by (DEPARTMENT_ID string)\nstored as orc\nlocation '/FileStore/tables/suankiData/transformed/suanki_employee_partitioned'",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/sql",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "sql",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
