    {
      "text": "%python\n\n# //since we have set hive.metastore.warehouse.dir = FileStore/tables/suankiData/stage , spark should wrtie the table to this location \n# //lets check\nspark.sql(\"\"\"\ncreate  table stg_db.createdWithSparkSql(\n  destination string,\n  origin string,\n  totalCount Int\n)\nrow format delimited \nfields terminated by \",\"\nlines terminated by \"\\n\"\n\"\"\")\n",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/python",
        "editorSetting": {
          "params": {},
          "forms": {},
