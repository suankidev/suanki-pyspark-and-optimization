      "text": "%sql\nselect o.order_id, o.order_Date,o.order_status,\n   oi.order_item_product_id, oi.order_item_sub_totabl\nFROM retail_db.orders o left join retail_db.order_item oi \n    ON o.order_id = oi.order_item_order_id limit 10\n\n    --null in order_item b/c order_id 3 is not present in order_item",
