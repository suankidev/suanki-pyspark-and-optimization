    {
      "text": "%spark\nspark.sql(\"describe formatted orders\").show(40,truncate=false)",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/scala",
        "editorSetting": {
          "params": {},
