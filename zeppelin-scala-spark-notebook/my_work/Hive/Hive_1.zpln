      "id": "11654a9eaa824e4fa65dd"
    },
    {
      "text": "%sql\nset hive.exec.dynamic.partition.mode=nonstrict;\nset hive.exec.max.dynamic.partitions.pernode=200;\nset hive.exec.max.dynamic.partitions=200\nset hive.exec.max.created.files=200\n\nINSERT overwrite transform_db.suanki_employee_partitioned PARTITION(DEPARTMENT_ID) \nselect  \ncast(EMPLOYEE_ID as int) as id,\nconcat(FIRST_NAME,Last_name) as full_name,\nEMAIL,\nPHONE_NUMBER,\nto_date(hire_date,'yy-MMM-dd') as hire_date,\njob_id,\ncast(SALARY as DOUBLE) as salary,\ncast(MANAGER_ID as int) as manager_id,\nDEPARTMENT_ID\n FROM stg_db.suanki_employee_stg where EMPLOYEE_ID is not NULL\n",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/sql",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "sql",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "5142880eba034d4d83b1d"
    },
