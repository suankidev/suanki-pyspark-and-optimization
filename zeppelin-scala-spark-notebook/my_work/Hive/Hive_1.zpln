    {
      "text": "%sql\n-- map task  --> shuffle --> reduce tasks\n-- distribution is used to distribute the data while shuffle stage\n--\nselect order_item_order_id,\nsum(order_item_sub_totabl) as order_revenue\nfrom retail_db.order_item\ngroup by order_item_order_id\ndistribute by order_item_order_id --use when global sorting is not required\nlimit 10",
      "config": {
