    {
      "text": "%sql\n--joining multiple tables\n--all the order_detail from order_items for order_id in order\n\nselect o.order_id, o.order_Date,o.order_status,\n   oi.order_item_product_id, oi.order_item_sub_totabl\nFROM retail_db.orders o inner join retail_db.order_item oi \n    ON o.order_id = oi.order_item_order_id limit 10",
