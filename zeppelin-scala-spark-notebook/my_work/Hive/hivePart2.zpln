          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "97d3daec83de46e687075"
    },
    {
      "text": "%fs\nput \"1|'ram'|23\\n2|'shyam'|24\"  dbfs:/FileStore/tables/suankiData/raw/vibha/demo_stg ",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/plain_text",
        "editorSetting": {
