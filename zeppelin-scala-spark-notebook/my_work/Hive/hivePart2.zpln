    {
      "text": "%sql\n--bucketing\ncreate external table if not exists vibha.demo_bucket(\nid int,\nname string,\nage int,\ninsert_date int\n)\nclustered by(age) into 3 buckets\nstored as parquet\nlocation 'dbfs:/FileStore/tables/suankiData/raw/vibha/demo_bucket';",
