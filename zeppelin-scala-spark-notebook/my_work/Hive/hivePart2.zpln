      },
      "id": "5f85ad2610864009a73fe"
    },
    {
      "text": "%sql\ndrop database vibha cascade;\ncreate database if not exists vibha location \"/FileStore/tables/suankiData/raw/vibha\";\ndrop table if exists vibha.demo_stg;\ncreate external table if not exists vibha.demo_stg (\n id string,\n name string,\n age string,\n insert_date  string\n)\nrow format delimited\nfields terminated by '|'\nlines terminated by '\\n'\nstored as textfile\nlocation '/FileStore/tables/suankiData/raw/vibha/demo_stg'\n",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/sql",
        "editorSetting": {
          "params": {},
          "forms": {},
          "language": "sql",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
