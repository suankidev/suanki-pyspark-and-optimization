    {
      "text": "%sql\n\ninsert into vibha.demo_stg values\n(1, 'ram',23,'2023'),\n(2, 'ram1',24,'2023'),\n(3, 'ram2',25,'2023'),\n(4, 'ram3',26,'2024'),\n(5, 'ram4',27,'2022')\n;",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/sql",
        "editorSetting": {
          "params": {},
