      "id": "3ffb695cae9f4cfb8e400"
    },
    {
      "text": "%sql\nset hive.exec.dynamic.partition.mode=nonstrict;\ninsert overwrite table vibha.demo \npartition(insert_date) \nselect \ncast(id as int) as id,\n name,\ncast(age as int) as age, \ninsert_date \nfrom vibha.demo_stg;",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/sql",
        "editorSetting": {
          "params": {},
          "forms": {},
