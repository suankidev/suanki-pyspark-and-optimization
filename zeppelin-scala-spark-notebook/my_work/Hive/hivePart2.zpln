    {
      "text": "%sql\ncreate external table if not exists vibha.demo(\nid int,\nname string,\nage int\n)\npartitioned by(insert_date string)\nstored as parquet\nlocation 'dbfs:/FileStore/tables/suankiData/raw/vibha/demo';",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
