    },
    {
      "text": "%sql\ndescribe database vibha;",
      "config": {
        "colWidth": 12,
        "fontSize": 9,
        "enabled": true,
        "editorMode": "ace/mode/sql",
        "editorSetting": {
          "params": {},
          "forms": {},
