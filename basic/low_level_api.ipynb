    "from pyspark.sql.session import SparkSession\n",
    "\n",
    "spark = (\n",
    "    SparkSession\n",
    "    .builder\n",
    "    .appName(appName)\n",
    "    .master(\"local[*]\")\n",
    "    .config(\"spark.port.maxRetries\", \"0\")\n",
    "    .getOrCreate()\n",
    ")\n",
    "spark.sparkContext.setLogLevel(\"ERROR\")\n",
    "\n",
    "sc = spark.sparkContext\n",
    "sc"
